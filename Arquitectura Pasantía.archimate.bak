  <folder name="Motivation" id="id-aba84e07c77b4289b2cf81dcc26ffb9e" type="motivation">
    <folder name="Interesados" id="id-14b374365d8c4e989d9509a4317eec13">
      <element xsi:type="archimate:Stakeholder" name="Asamblea Campesina " id="id-8f11a29fa7f645d0a4382ee237428004"/>
      <element xsi:type="archimate:Stakeholder" name="Colectivos" id="id-714e884a55af4fd69d68a5e733c55fa6"/>
      <element xsi:type="archimate:Stakeholder" name="Comités" id="id-affdbebac4e347db9e371ac46776750d"/>
      <element xsi:type="archimate:Stakeholder" name="Directiva Central" id="id-77d237e8ea034bd0a24e5ec38cc4b1b8"/>
      <element xsi:type="archimate:Stakeholder" name="JAC Veredales" id="id-886c38b3b3214f3cb6280364f6ce7ab5"/>
      <element xsi:type="archimate:Stakeholder" name="Subdirectivas Zonales" id="id-e9743d7156074586a0cf1ea15287959e"/>
    </folder>
    <folder name="Objetivos" id="id-503e062d568b477bb1b5201568daf28d">
      <element xsi:type="archimate:Goal" name="Fortalecer la gestión y defensa del territorio" id="id-a070546e75c84be193da9e5aee1de22c">
        <documentation>Fortalecer la gestión y defensa del territorio mediante la integración de información social, predial, jurídica, ambiental y geográfica.</documentation>
      </element>
      <element xsi:type="archimate:Goal" name="Garantizar la preservación y continuidad de la memoria organizacional" id="id-dbf8879bd1f64892a418becee051dfb1">
        <documentation>Garantizar la preservación y continuidad de la memoria organizacional entre proyectos, responsables y periodos de dirección.</documentation>
      </element>
      <element xsi:type="archimate:Goal" name="Fortalecer las áreas y procesos apoyados por la ACIT" id="id-d4f41a9dd22f482d919c1bdd2a6dcac7">
        <documentation>Fortalecer la documentación, acompañamiento, memoria organizacional y líneas de ejecución frente a los diferentes procesos que lleva la ACIT.</documentation>
      </element>
      <element xsi:type="archimate:Goal" name="Fortalecer la gobernanza territorial, organizacional y de información de la ACIT" id="id-190742200dc54a73a102c1e15ddf91ab"/>
      <element xsi:type="archimate:Goal" name="Garantizar la soberanía, integridad y acceso a la información" id="id-0ed45a94ea7e455592dfb4fb904e88d9">
        <documentation>Asegurar la protección, integridad, disponibilidad y acceso colectivo a la información institucional y territorial, promoviendo su administración por parte de la propia organización y fortaleciendo la autonomía en la gestión del conocimiento.</documentation>
      </element>
      <element xsi:type="archimate:Goal" name="Implementar la seguridad de la información" id="id-f7cc4704284c4f0b8d70453ee79b4681">
        <documentation>Consolidar la información generada por la ACIT como un activo estratégico para la organización, fortaleciendo su uso en los procesos de planificación, gestión territorial, formulación de proyectos y toma de decisiones. </documentation>
      </element>
      <element xsi:type="archimate:Goal" name="Misión: Organización, Defensa y Poder Popular" id="id-fdec46cfb4594e42bcaff54f33505b16">
        <documentation>Organizar, fortalecer y representar al campesinado de Inzá mediante procesos de formación, participación y desarrollo comunitario que contribuyan a la defensa del territorio, el fortalecimiento de la economía campesina y la construcción del poder popular.&#xD;
</documentation>
      </element>
      <element xsi:type="archimate:Goal" name="Visión: Autonomía, Soberanía y Reconocimiento Campesino." id="id-7d88eacbd3d84c10a46c7801c61649c7">
        <documentation>Consolidar un territorio campesino autónomo, reconocido como sujeto colectivo de derechos, donde la identidad campesina, la participación comunitaria, la interculturalidad y el poder popular garanticen la permanencia digna de las comunidades en el territorio y el desarrollo sostenible de Inzá.</documentation>
      </element>
      <element xsi:type="archimate:Goal" name="Fortalecer la gobernanza institucional de la información de la ACIT" id="id-8cde2f62dd0e4e6fa6706ab857e4bb67"/>
    </folder>
    <folder name="Motivadores" id="id-8a8c5770d6af4c508688ab2ef74c90c4">
      <folder name="Otros" id="id-9f4d1069c5a1474bb67f5083d60e79e0"/>
      <element xsi:type="archimate:Driver" name="Crecimiento y dispersión de la información organizacional" id="id-bb0038f5a3834271b966acd804740656">
        <documentation>La ACIT produce información territorial, social, ambiental, productiva, jurídica, administrativa, histórica y política mediante múltiples proyectos, comités y responsables, pero esta permanece distribuida en equipos, personas, correos, archivos físicos, Drive y aplicaciones diferentes.</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="Sensibilidad de la información institucional y territorial" id="id-3aad8a5f0b5340bebf3d0d530e7b290f">
        <documentation>La preservación y transmisión de los saberes, prácticas, valores e identidad campesina como elementos fundamentales para garantizar la permanencia cultural, fortalecer el tejido social y consolidar el reconocimiento del campesinado como sujeto histórico y político.</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="Producción histórica de conocimiento campesino" id="id-1f0304220d7b49458edbc10af99347ca">
        <documentation>Los cambios de directivas, coordinaciones, proyectos y responsables pueden provocar pérdida de conocimiento, dificultades de empalme y dependencia de la memoria de personas específicas.</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="Complejidad territorial, ambiental y productiva" id="id-d51be6e18e584a75ae5252c73e090919">
        <documentation>La necesidad de garantizar el acceso, la permanencia y la seguridad jurídica sobre la tierra, promoviendo un modelo de tenencia basado en su función social, el arraigo territorial y el derecho de las familias campesinas a vivir y producir dignamente en el territorio.</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="Autonomía y soberanía de la información territorial" id="id-97fc014b8b0340f4aac1956f50d2f715">
        <documentation>La necesidad de garantizar que la información generada por las comunidades campesinas sea gestionada, protegida y utilizada por la propia organización como un recurso estratégico para la toma de decisiones, la planificación territorial y el fortalecimiento de la autonomía organizativa.</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="Diversidad de procesos y fuentes de información" id="id-9849223a59a44cff8011b1655f1b470d"/>
      <element xsi:type="archimate:Driver" name="Rotación de responsables y directivas" id="id-c46455308aa54f729ac7b964dc629629"/>
    </folder>
    <folder name="Resultados" id="id-9c7717d68f284786950ea4394c5cff4e">
      <element xsi:type="archimate:Outcome" name="Información institucional localizada oportunamente" id="id-0240580e8aba414d93625c6a33411de2">
        <documentation>Tiempo de localización de información institucional crítica reducido a un máximo de 10 minutos.</documentation>
      </element>
      <element xsi:type="archimate:Outcome" name="Información territorial integrada" id="id-b432edb9afa84e3298030dd47ac96376">
        <documentation>Consultas territoriales resueltas mediante información social, predial, jurídica y geográfica relacionada incrementadas al 90%.</documentation>
      </element>
      <element xsi:type="archimate:Outcome" name="Información sensible protegida" id="id-65b52a482c574c3183245425d3528705">
        <documentation>Activos de información críticos clasificados por nivel de acceso en el 100% de los casos inventariados.</documentation>
      </element>
      <element xsi:type="archimate:Outcome" name="Compromisos organizacionales trazables" id="id-1137e350c6af4b25a660ee2f1b6aaf21">
        <documentation>Compromisos institucionales estratégicos registrados con responsable, fecha y estado en el 100 % de los casos priorizados.</documentation>
      </element>
      <element xsi:type="archimate:Outcome" name="Dependencia de documentación individual reducida" id="id-0516653b80a8482494729da5ed20978e">
        <documentation>Procesos críticos dependientes exclusivamente del conocimiento de una persona reducidos</documentation>
      </element>
      <element xsi:type="archimate:Outcome" name="Memoria histórica organizacional recuperada y preservada" id="id-2aa0a8bd53f54bf7b2eb12f070836dcd">
        <documentation>Experiencias, proyectos e hitos históricos priorizados catalogados y recuperables en al menos el 90 % de los casos identificados.</documentation>
      </element>
      <element xsi:type="archimate:Outcome" name="Acompañamiento de procesos articulado y sistematizado" id="id-d08070cd3ccc411c9def3edaa8f656f9">
        <documentation>Incorporadas las necesidades de información de los procesos de la ACIT en la arquitectura del SITC, dejando definida su trazabilidad para el desarrollo futuro de módulos y funcionalidades específicas para aumentar el acompañamiento.</documentation>
      </element>
    </folder>
    <folder name="Evaluaciones" id="id-d0e0e6c847764fe1b89fc3d45960e7d7">
      <folder name="Otros" id="id-fbd3e1466955449e9ebb8d330700a115"/>
      <element xsi:type="archimate:Assessment" name="La información e investigación generada no está articulada" id="id-c9bc3ed54f7247dca4c5138e0790e3f8">
        <documentation>Una parte de la producción académica y comunitaria no se encuentra catalogada ni relacionada con los procesos y territorios que la originaron.</documentation>
      </element>
      <element xsi:type="archimate:Assessment" name="Se tiene información con diferentes niveles de sensibilidad" id="id-24aa52c712144d1e99b07e80c953099e">
        <documentation>La ACIT administra datos personales, financieros, prediales, jurídicos, ambientales, bioculturales y de derechos humanos con diferentes niveles de sensibilidad.</documentation>
      </element>
      <element xsi:type="archimate:Assessment" name="La información permanece distribuida y descentralizada" id="id-4a7b8cd1a7b84d6592d5e52160b074e9">
        <documentation>La información de la ACIT permanece distribuida entre personas, computadores, discos, archivos físicos, correos y plataformas digitales.</documentation>
      </element>
      <element xsi:type="archimate:Assessment" name="Riesgo: Ataques Cibernéticos" id="id-7c6f1baa76d94b8f9ae96cdb11b9153a"/>
      <element xsi:type="archimate:Assessment" name="Riesgo: Robo de información sensible" id="id-3f02bdfdaafe4efd900c7d5a61fdce0a"/>
      <element xsi:type="archimate:Assessment" name="Vulnerabilidad: Datos Centralizados" id="id-cb520bf3432a4fb497334fd0270d62b3"/>
      <element xsi:type="archimate:Assessment" name="Vulnerabilidad: Información Dispersa" id="id-16a4db501bb943a798e319c851240686"/>
      <element xsi:type="archimate:Assessment" name="Riesgo: Perdida de la información" id="id-7d9e4413a7fa49d8828becdefe9171e5"/>
      <element xsi:type="archimate:Assessment" name="Debilidad: Procesos de información parcialmente sistematizados" id="id-42ba134e970749c78d69777a6435afcb">
        <documentation>Gran parte de la información institucional y territorial aún se administra mediante procedimientos manuales y herramientas dispersas, dificultando su consulta, actualización y preservación.</documentation>
      </element>
      <element xsi:type="archimate:Assessment" name="Hay una variedad de información y clasificación amplia" id="id-b0606b7c62094d4bb2ebf9bbcc8cb387">
        <documentation>Los proyectos y procesos producen información con metodologías, estructuras, niveles de actualización y finalidades diferentes.</documentation>
      </element>
      <element xsi:type="archimate:Assessment" name="La información de proyectos está concentrada en sus coordinadores" id="id-a3acff5990ec4396b53ad1a7e806a9ba">
        <documentation>La memoria de proyectos, comités y procesos permanece parcialmente concentrada en quienes los han coordinado.</documentation>
      </element>
      <element xsi:type="archimate:Assessment" name="La comprensión del territorio requiere relacionar información diversa" id="id-14515a856ff249b68d3e87ab135dfdcb">
        <documentation>La comprensión del territorio requiere relacionar información predial, poblacional, jurídica, productiva, ambiental, climática y organizativa.</documentation>
      </element>
    </folder>
    <folder name="Principios" id="id-4a307e494dfc41dfb079bbd8b2f2700d">
      <element xsi:type="archimate:Principle" name="Soberanía comunitaria de la información" id="id-610c5590f7474d93ba54834f9e682f15">
        <documentation>La ACIT mantiene autoridad sobre el uso, acceso, intercambio, publicación y reutilización de la información producida por sus procesos y comunidades.&#xD;
&#xD;
Justificación / implicación:&#xD;
Los datos no deben considerarse disponibles para terceros únicamente porque hayan sido digitalizados. El acceso debe responder a decisiones organizativas y comunitarias.</documentation>
      </element>
      <element xsi:type="archimate:Principle" name="Seguridad y protección del conocimiento campesino" id="id-11215fd6c9304bb590466fc88a921539">
        <documentation>La protección de la información se incorporará desde el diseño de procesos, aplicaciones y servicios.&#xD;
El conocimiento campesino, biocultural y comunitario recibirá niveles de protección acordes con su naturaleza y riesgo.</documentation>
      </element>
      <element xsi:type="archimate:Principle" name="Procedencia y contexto de la información" id="id-6d77d320a0064d6f97c4542bab5f1e2f">
        <documentation>Todo conjunto de información conservará su origen, propósito, metodología, periodo y responsable de producción.</documentation>
      </element>
      <element xsi:type="archimate:Principle" name="Apropiación tecnológica comunitaria" id="id-8ef750300bf748bf9557741e7e7c86ae">
        <documentation>La tecnología deberá ser administrable y comprensible progresivamente por la organización.&#xD;
&#xD;
Implicación:&#xD;
Las decisiones tecnológicas deberán evitar dependencias innecesarias de personas, proveedores o desarrolladores particulares.</documentation>
      </element>
      <element xsi:type="archimate:Principle" name="Autonomía y soberanía tecnológica" id="id-ce3b41784141417296c801da50037e33">
        <documentation>Las soluciones tecnológicas deberán fortalecer y no sustituir la capacidad política, comunitaria y territorial de decisión.</documentation>
      </element>
    </folder>
    <folder name="Requerimientos" id="id-36906f1f36424c798eb9915e0d68efcc">
      <element xsi:type="archimate:Requirement" name="Es necesario un control de acceso a la información" id="id-9323fa60b8224b0d93d7d7c4df92a704"/>
      <element xsi:type="archimate:Requirement" name="El sistema deberá almacenar documentos y gestionar diversos tipos de datos" id="id-0468c8ec65d144369495c4bdc46fb0bd"/>
      <element xsi:type="archimate:Requirement" name="El sistema se deberá diseñar de manera modular y escalable" id="id-a08bc76f6994483f9e8ae64d9358dad9">
        <documentation>El sistema deberá diseñarse de manera modular y escalable, permitiendo incorporar nuevos requerimientos y funcionalidades asociados a las diferentes áreas de procesos de la ACIT</documentation>
      </element>
      <element xsi:type="archimate:Requirement" name="El sistema deberá organizar lógicamente los datos de acuerdo con las principales áreas de procesos de la ACIT" id="id-eadceb08be2540ddaba6bd8eb87b803f">
        <documentation>El sistema deberá gestionar de manera diferenciada los datos generados por los procesos y proyectos de la ACIT mediante módulos temáticos, permitiendo su organización, consulta, actualización y relación con la información territorial para apoyar la sistematización y el análisis de las dinámicas del territorio campesino.</documentation>
      </element>
      <element xsi:type="archimate:Requirement" name="El SITC deberá permitir registrar y consultar información mediante clasificación y permisos" id="id-1f9aa7ab55124f3897e3585fd2aa0007">
        <documentation>El SITC deberá permitir registrar y consultar documentos mediante metadatos de proyecto, área (multivalor), territorio, periodo, autor, responsable y nivel de acceso.</documentation>
      </element>
      <element xsi:type="archimate:Requirement" name="La ACIT deberá definir una instancia responsable del sistema" id="id-3033fc6ffb4e473b99a491b5159bed60">
        <documentation>La ACIT deberá definir una instancia responsable del gobierno de la información y de la continuidad institucional del SITC.</documentation>
      </element>
      <element xsi:type="archimate:Requirement" name="Los proyectos y convenios deberán transferir a la organización los activos de información" id="id-b7e293190be24375aa50ee2fb5d15202">
        <documentation>Los proyectos y convenios deberán transferir a la organización los productos, bases, documentos, metodologías y demás activos de información generados durante su ejecución.</documentation>
      </element>
      <element xsi:type="archimate:Requirement" name="Es necesario implementar la GSI" id="id-c4f766eac0a740fea1ad4a61239b1bd2">
        <documentation>Es necesario implementar la gestión de la seguridad de la información dentro del sistema y la organización.</documentation>
      </element>
    </folder>
    <folder name="Valores" id="id-795bc8ad450a416681c420ad01794d45">
      <element xsi:type="archimate:Value" name="Autonomía organizacional" id="id-09d915d24a174f5d9debc685ceb8fb5c">
        <documentation>Capacidad de sostener decisiones, procesos y conocimiento sin depender excesivamente de personas o actores externos.</documentation>
      </element>
      <element xsi:type="archimate:Value" name="Continuidad organizacional" id="id-0d42908c5b1d4e98a1e033f59683e857">
        <documentation>Permanencia de procesos, compromisos y conocimiento a pesar de cambios de personas, proyectos o periodos de dirección.</documentation>
      </element>
      <element xsi:type="archimate:Value" name="Soberanía sobre la información" id="id-401a699e9bcd46e5942ce56a6dccac50">
        <documentation>Control efectivo sobre quién accede, utiliza, comparte o reutiliza la información producida por la organización y las comunidades.</documentation>
      </element>
      <element xsi:type="archimate:Value" name="Acceso oportuno al conocimiento organizacional" id="id-8e46868bfbff40a88c58eb3887c43e97">
        <documentation>Posibilidad de encontrar antecedentes, estudios, proyectos y documentos sin reconstruirlos desde cero.</documentation>
      </element>
      <element xsi:type="archimate:Value" name="Seguridad de la información sensible" id="id-e0e32e89f20a4f4f8f68cc2812159a04">
        <documentation>Confianza en que información personal, jurídica, financiera, territorial o de DD. HH. será protegida según su nivel de sensibilidad.</documentation>
      </element>
      <element xsi:type="archimate:Value" name="VALOR" id="id-975dd902b1254ec5ad11b2cb37f3298a"/>
    </folder>
    <folder name="Restricciones" id="id-fd29a948e2a3410f87d0df6199903cea">
      <element xsi:type="archimate:Constraint" name="Restricción de disponibilidad de recursos" id="id-2c90758dbe2a4514bf513ec8a0ab39a3">
        <documentation>La implementación del Sistema de Información Territorial Campesino (SITC) está limitada a la disponibilidad de recursos financieros y de apoyo técnico obtenidos mediante proyectos, convenios y alianzas con entidades educativas, organizaciones de cooperación u otras entidades vinculadas a su desarrollo.</documentation>
      </element>
    </folder>
    <element xsi:type="archimate:Stakeholder" name="Asociados ACIT" id="id-9aef5c31afc14f94b3e601450f475a4c"/>
  </folder>
  <folder name="Implementation &amp; Migration" id="id-5e780191c1bc4d669e5f2e063a27b7f7" type="implementation_migration"/>
