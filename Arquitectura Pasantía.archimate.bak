        <child xsi:type="archimate:Note" id="id-9bda3f44a8044ca2a1268db48c0f788d" textPosition="1">
          <bounds x="60" y="36" width="149" height="60"/>
          <sourceConnection id="id-576aca51259047ee98a0b254c016b18d" source="id-9bda3f44a8044ca2a1268db48c0f788d" target="id-4c672766810e414e91faa59247abaa92"/>
          <content>¿A QUIÉN&#xD;
le interesa que se cumplan los objetivos?</content>
        </child>
        <child xsi:type="archimate:Note" id="id-65026edb1947434d9e52ca6405a1d20b" textPosition="1">
          <bounds x="60" y="107" width="149" height="108"/>
          <sourceConnection id="id-216582d4a294488e942fb33035d1915b" source="id-65026edb1947434d9e52ca6405a1d20b" target="id-7973aa500e6b4ce7883ade3bf7e976c3"/>
