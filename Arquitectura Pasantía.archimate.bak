        <child xsi:type="archimate:DiagramObject" id="id-e989a547fddc4746af3a2714eab79773" targetConnections="id-caf9b9f123ea4e01a36787c7622e2754 id-46a1afb496e24221a87026e8a52b81dd" archimateElement="id-bcd7cdc1b8f24d77bd05beac746af553">
          <bounds x="968" y="48" width="150" height="55"/>
