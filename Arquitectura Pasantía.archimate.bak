        <child xsi:type="archimate:Note" id="id-d03e7c0437934578a5ac75a3ce861ab4" textAlignment="1">
          <bounds x="60" y="36" width="173" height="61"/>
          <content>Se muestra los componentes que intercambian información y que sirven a otros</content>
        </child>
        <documentation>¿Qué componentes intercambian servicios o información entre sí?</documentation>
      </element>
      <element xsi:type="archimate:ArchimateDiagramModel" name="4.7. Funciones de aplicación" id="id-8d51df2ab1a747658a64bab91f66e790">
        <child xsi:type="archimate:Note" id="id-85823808dcc84e6cbd63b61ae09f4275" textAlignment="1">
          <bounds x="24" y="76" width="157" height="109"/>
          <content>Las funciones de aplicación describen el trabajo automatizado, la lógica de negocio o el procesamiento de datos que realiza un componente de software</content>
        </child>
        <child xsi:type="archimate:Note" id="id-01b4715a0edb4c95aa9c8fd0fae77446" textAlignment="1">
          <bounds x="648" y="82" width="193" height="97"/>
          <content>Representa el &quot;qué hace&quot; una aplicación internamente para soportar los servicios que ofrece al exterior, de manera independiente de cómo esté codificada</content>
        </child>
