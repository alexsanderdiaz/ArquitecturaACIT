        <child xsi:type="archimate:DiagramObject" id="id-898c861b7e47416e9053719fa0e808aa" targetConnections="id-48deb9f5a7d949789b77da4b546e4a09" archimateElement="id-6cdbc19ecf6945a2b5e22c166f4c36fc">
          <bounds x="408" y="253" width="136" height="59"/>
          <sourceConnection xsi:type="archimate:Connection" id="id-f0969d6bf614412fa010fe7807009d44" source="id-898c861b7e47416e9053719fa0e808aa" target="id-c70d32a3bc224af6ba4bf968e1443d56" archimateRelationship="id-07b9b64b6e144207ac55fcf65c3de7c7"/>
          <sourceConnection xsi:type="archimate:Connection" id="id-2504be5c49954984be240eb61c0aea9f" source="id-898c861b7e47416e9053719fa0e808aa" target="id-a4af73fb5ab1473a9cdb6821af7b0a8e" archimateRelationship="id-55f24f78f3b04bd1be7a68a288b3099e"/>
