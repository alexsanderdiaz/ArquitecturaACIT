          <bounds x="499" y="36" width="174" height="67"/>
          <content>Flujo de valor al que se quiere llegar con el sistema y la capacidad que lo soporta</content>
        </child>
        <child xsi:type="archimate:Note" id="id-9a8d782e12d040ba8f6b0e52bccef537" textAlignment="1">
          <bounds x="636" y="142" width="161" height="59"/>
