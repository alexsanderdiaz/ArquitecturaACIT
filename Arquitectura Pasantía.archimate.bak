      <element xsi:type="archimate:Product" name="Informes multidimensionales por componentes" id="id-fe8fcc61ecd542d19730c60fa81aa956"/>
    </folder>
    <folder name="Objetos" id="id-9c014464883349188283d0cdacd002ad">
      <element xsi:type="archimate:BusinessObject" name="Plan de desarrollo sostenible" id="id-5ea9f63020b94fb292e9a9acfd624492"/>
    </folder>
    <folder name="Contratos" id="id-1092785ee9434f5eada650472909399c">
      <element xsi:type="archimate:Contract" name="Convenio" id="id-b3692b6433ff4f73a4184427f6a011e5"/>
    </folder>
    <element xsi:type="archimate:BusinessEvent" name="Siembra de frailejones" id="id-e3efb279c87244d284d3e24226cbca5c"/>
    <element xsi:type="archimate:BusinessEvent" name="Siembra de árboles" id="id-86ae1e2685054b72b8559d4d11649357"/>
    <element xsi:type="archimate:BusinessProcess" name="Articular procesos con escuelas territoriales" id="id-5e8ab24b58bf40719a80aafb6d71fe50"/>
    <element xsi:type="archimate:BusinessProcess" name="Fortalecer sistemas productivos campesinos mediante prácticas agroecológicas" id="id-90891222e02d40eb878ae6bbb9fe32f6">
      <documentation>Comprende el acompañamiento y fortalecimiento de los sistemas productivos familiares y comunitarios mediante prácticas como la diversificación y asociación de cultivos, producción orgánica, manejo sostenible del suelo y el agua, elaboración de abonos e insumos naturales, integración agrícola y pecuaria y transición progresiva hacia formas de producción agroecológica.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Conservar e intercambiar semillas y saberes agroalimentarios" id="id-11cd1ed2c216447ca1795d95fc1133b1">
      <documentation>Comprende la identificación, recuperación, reproducción, conservación, propagación e intercambio de semillas nativas, criollas y tradicionales, así como la transmisión de los conocimientos campesinos asociados a su cultivo, manejo y uso. Incluye prácticas familiares y comunitarias, casas de semillas e intercambios de saberes entre generaciones y productores.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Promover la autonomía y soberanía alimentaria campesina" id="id-30a8adc1fc5c43e7adc317ec0a211502">
      <documentation>Comprende las acciones orientadas a fortalecer la capacidad de las familias y comunidades para producir, seleccionar, intercambiar, preparar y consumir alimentos propios, saludables y culturalmente pertinentes, promoviendo las huertas, el autoconsumo, la diversidad alimentaria y la recuperación de prácticas campesinas relacionadas con la alimentación.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Identificar, monitorear y proteger la biodiversidad" id="id-45b209758a854bf3a4a497f3629b3574">
      <documentation>Comprende el reconocimiento, registro, seguimiento y protección de especies de flora y fauna y de los hábitats presentes en el territorio, articulando el conocimiento campesino con actividades de observación, recorridos territoriales y acciones comunitarias orientadas a conservar especies, polinizadores y ecosistemas de importancia ambiental.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Conservar y restaurar ecosistemas estratégicos" id="id-ac1e3fc9c902448aaf16d423e3b34520">
      <documentation>Comprende la identificación y recuperación de áreas de importancia ambiental o afectadas por procesos de degradación mediante reforestación, siembra y propagación de especies nativas, restauración de suelos y coberturas, protección de nacimientos y acciones comunitarias de conservación de bosques, montañas, páramos y corredores ecológicos.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Comercializar productos mediante circuitos campesinos y solidarios" id="id-6c1f47d064374782a44dfc6e91dfd349">
      <documentation>Comprende la organización de mecanismos para el intercambio, distribución y comercialización de productos campesinos mediante mercados locales, venta directa, tiendas comunitarias, ferias, circuitos cortos y otras alternativas que procuren reducir la intermediación, mejorar los ingresos familiares y fortalecer las relaciones entre productores y consumidores.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Gestionar comunitariamente las fuentes y sistemas de agua" id="id-d73b27b58643496ea3c739f8da54cc34">
      <documentation>Comprende la identificación, protección, mantenimiento y seguimiento de nacimientos, quebradas, lagunas, redes comunitarias de abastecimiento y demás fuentes hídricas, así como la construcción de acuerdos colectivos para su uso, conservación y recuperación y la atención comunitaria de afectaciones sobre el recurso hídrico.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Fortalecer capacidades para gestionar procesos de formación comunitaria" id="id-dca506f018a148b0b24ab483290d42f0">
      <documentation>Comprende la identificación y aprovechamiento de capacidades técnicas, profesionales y pedagógicas existentes entre integrantes de la organización, así como su articulación para formular proyectos, establecer alianzas y desarrollar nuevas iniciativas de formación dirigidas a las comunidades.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Crear y fortalecer iniciativas de economía social y solidaria" id="id-c603e4d44a4443b5ac60bed76c26f519">
      <documentation>Comprende la organización, acompañamiento y consolidación de iniciativas económicas colectivas basadas en la cooperación, reciprocidad, solidaridad y toma comunitaria de decisiones, incluyendo grupos de ahorro y crédito, fondos solidarios, tiendas y panaderías comunitarias, parcelas colectivas, asociaciones productivas y otras formas de economía campesina organizada.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Identificar y priorizar problemáticas y reivindicaciones colectivas" id="id-f65f5938712849ac900a2c399330779a">
      <documentation>Comprende la identificación, análisis y priorización de necesidades, problemáticas y reivindicaciones que afectan a las comunidades campesinas, a partir de espacios de deliberación como las Juntas de Acción Comunal, subdirectivas, comités, Junta Directiva y otros escenarios organizativos. Considera su urgencia, alcance colectivo, contexto político y viabilidad para definir cuáles asuntos requieren acción de la organización.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Definir estrategias de acción política y organizativa" id="id-89473636381f41eb8958433f3b719d27">
      <documentation>Comprende el análisis del contexto político, institucional y organizativo y la definición colectiva de las estrategias mediante las cuales la ACIT responderá a las problemáticas priorizadas, incluyendo gestión institucional, movilización social, acciones jurídicas, cooperación, articulación con organizaciones aliadas o combinación de diferentes mecanismos.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Gestionar incidencia y articulación política e institucional" id="id-36412e5eb4ce4a65a0159a5cc3351da9">
      <documentation>Comprende la representación de las reivindicaciones y propuestas campesinas ante entidades públicas, espacios de concertación y otros actores institucionales, mediante reuniones, mesas de negociación, agendas de interlocución, participación en escenarios de incidencia y seguimiento a compromisos adquiridos.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Gestionar alianzas y redes de cooperación" id="id-a255f36ad71145039656e90016e19fba">
      <documentation>Comprende la identificación, activación, construcción y mantenimiento de relaciones con organizaciones sociales, profesionales solidarios, universidades, ONG, entidades de cooperación y otros actores aliados que puedan aportar capacidades técnicas, jurídicas, políticas, académicas o financieras a las iniciativas de la ACIT.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Formular y gestionar proyectos comunitarios" id="id-3e0da5f81fc743ce9b84f7446d193c9a">
      <documentation>Comprende la estructuración de iniciativas y proyectos a partir de necesidades comunitarias priorizadas, incluyendo la formulación técnica y financiera, búsqueda de fuentes de financiación, presentación ante cooperantes o entidades, formalización mediante convenios o contratos y seguimiento a su ejecución.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Caracterizar población, predios y dinámicas territoriales" id="id-bdef16baf0644e9e8bd4f5027c4221a3">
      <documentation>Comprende la recolección, validación, organización y análisis de información sobre población, predios, formas de tenencia, identidad campesina, usos del suelo y demás características territoriales necesarias para sustentar procesos de planificación, acceso a tierras, defensa territorial, formulación de proyectos y toma de decisiones.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Gestionar el acceso, formalización y adquisición de tierras" id="id-6e65e77a61e949e3a0319a502934ca15">
      <documentation>Comprende la identificación y evaluación de predios requeridos por familias, comunidades u organización, el análisis de su viabilidad jurídica, ambiental, agronómica y productiva, y la gestión de los procedimientos necesarios para su adjudicación, formalización, compra, entrega o adquisición colectiva.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Formular y actualizar instrumentos de planificación territorial campesina" id="id-276b42ffc8584c44a8e0a31d46f72a82">
      <documentation>Comprende la construcción participativa de diagnósticos, análisis y propuestas para orientar el ordenamiento y desarrollo del territorio campesino mediante instrumentos como el Plan de Desarrollo Sostenible de la Zona de Reserva Campesina, integrando componentes territoriales, ambientales, económicos, productivos, sociales e históricos.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Implementar y hacer seguimiento a la planificación territorial campesina" id="id-f5ffab6552774b94a283af349a51f37d">
      <documentation>Comprende la coordinación, seguimiento y evaluación de las acciones definidas en los instrumentos de planificación territorial campesina, articulando a los diferentes comités, comunidades, proyectos y actores responsables de desarrollar sus componentes.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Gestionar conflictos territoriales e interculturales" id="id-babb0950bc1743b5bfff40bd933f9118">
      <documentation>Comprende la identificación, caracterización, documentación y análisis de conflictos relacionados con el uso, ocupación, identidad y reconocimiento del territorio, así como el desarrollo de acciones comunitarias, políticas e institucionales orientadas a su prevención, tratamiento, concertación o resolución.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Defender jurídicamente derechos y reivindicaciones territoriales" id="id-b7df8eed0d374aa0a15dc2cd137454b0">
      <documentation>Comprende la identificación y análisis jurídico de afectaciones, incumplimientos o reivindicaciones relacionadas con la tierra y el territorio, la definición de la estrategia jurídica aplicable y la formulación, presentación y seguimiento de actuaciones administrativas o judiciales orientadas a proteger los derechos e intereses de las comunidades campesinas.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Documentar y sustentar la defensa del territorio" id="id-db0b17b426374faaaf9550051618b76e"/>
    <element xsi:type="archimate:BusinessService" name="Servicio de gestión de la información de procesos campesinos" id="id-6ebe29a263354c5db04323d2c21efe9e"/>
    <element xsi:type="archimate:BusinessService" name="Articulación de alianzas estratégicas" id="id-6f3c6d15a6754ac2b05e958aa924a24d">
      <documentation>Articulación de alianzas estratégicas</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Gestión de compromisos institucionales" id="id-a8d2138b33e0408aa3e510261966c38d"/>
    <element xsi:type="archimate:BusinessService" name="Caracterización territorial campesina" id="id-18de9276781a46479a115f7e880cfa70"/>
    <element xsi:type="archimate:BusinessService" name="Acompañamiento de acceso a tierras" id="id-d8a4557c4aea4a609e852f0c52dbd7fb"/>
    <element xsi:type="archimate:BusinessService" name="Acompañamiento de formalización de derechos sobre la tierra" id="id-a899120bbb064d599de02b25d7135f9b"/>
    <element xsi:type="archimate:BusinessService" name="Defensa jurídica territorial" id="id-b95a2f946da34dc891449da12dfc488e">
      <documentation>Brinda soporte jurídico para proteger derechos y reivindicaciones sobre el territorio.</documentation>
    </element>
    <element xsi:type="archimate:BusinessService" name="Seguimiento de expedientes jurídicos" id="id-6df04a7acdea4f098fb2949a4d0ebeb4"/>
    <element xsi:type="archimate:BusinessService" name="Representación de intereses campesinos" id="id-1301e846b82046f7af2a575236a25b6d"/>
    <element xsi:type="archimate:BusinessService" name="Incidencia en decisiones públicas" id="id-3ece907a15db425aa112b3f4bf89b8a0"/>
    <element xsi:type="archimate:BusinessService" name="Gestión de la Zona de Reserva Campesina" id="id-bcdd351ca9a74bb5b848182441b4c195"/>
