    <element xsi:type="archimate:DataObject" name="Datos poblacionales y de identidad" id="id-37f65887dcd14bc88794cd22975d15be">
      <documentation>Define de manera demográfica quiénes habitan el territorio y bajo qué lógicas culturales se organizan</documentation>
    </element>
    <element xsi:type="archimate:DataObject" name="Datos prediales y de tenencia de la tierra" id="id-e0da138100f74e14b73ce0444f8c7882">
