<?xml version="1.0" encoding="UTF-8"?>
<archimate:model xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:archimate="http://www.archimatetool.com/archimate" name="Arquitectura ACIT" id="id-c1afdd1d50404b8f8ec0feee4ac0f25d" version="5.0.0">
  <folder name="Strategy" id="id-329190d3a3e94862b8fbfb126ead397e" type="strategy">
    <folder name="Curso de acción" id="id-fc0a85bca38a4200a1e2c0086572762a">
      <element xsi:type="archimate:CourseOfAction" name="Desarrollo progresivo del SITC" id="id-e403eae88b58436dae0b1af9bc03aea8">
        <documentation>Desarrollar progresivamente capacidades digitales que integren información territorial, organizativa y de conocimiento de los diversos procesos que lleva la ACIT.</documentation>
      </element>
      <element xsi:type="archimate:CourseOfAction" name="Consolidación de expedientes organizacionales" id="id-9815def4fd8d45d7b51e4ea434e6cecb">
        <documentation>Expedientes y clasificación de procesos:&#xD;
Aplicable a:&#xD;
&#xD;
- procesos jurídicos;&#xD;
- procesos territoriales;&#xD;
- proyectos;&#xD;
- DD. HH.;&#xD;
- compromisos institucionales.</documentation>
      </element>
      <element xsi:type="archimate:CourseOfAction" name="Consolidación de la estructura de gestión del SITC" id="id-7976f623578f4b23a4c061171901aaa5"/>
      <element xsi:type="archimate:CourseOfAction" name="Institucionalización de la memoria organizacional" id="id-ae0b9001b42342ffb2825920ba4b486c">
        <documentation>Trasladar progresivamente conocimiento, antecedentes y documentación desde custodios individuales hacia mecanismos institucionales de conservación y reutilización.</documentation>
      </element>
      <element xsi:type="archimate:CourseOfAction" name="Institucionalización de empalmes organizacionales" id="id-497b08ae3b5843cf8cedc6dedac3afa6">
        <documentation>Busca convertir el empalme en práctica estable para:&#xD;
&#xD;
directivas;&#xD;
proyectos;&#xD;
comités;&#xD;
roles administrativos;&#xD;
responsables tecnológicos.</documentation>
      </element>
    </folder>
    <folder name="Capacidades" id="id-9c8734dbf4c74118a561164470859032">
      <folder name="Otros" id="id-916d5ea62212428c879e8816a1bca89d">
        <element xsi:type="archimate:Capability" name="Capacidades misionales" id="id-9a0dee9aa62d4365bc614c89465d9c9e"/>
        <element xsi:type="archimate:Capability" name="Capacidades estratégicas y de gobernanza" id="id-30dd4d2792dd4f3ba2ad07497c26bb50"/>
      </folder>
      <element xsi:type="archimate:Capability" name="Gobierno de información y conocimiento organizacional" id="id-db39b4a2f7284d32b86018a3d3904957">
        <documentation>Capacidad para gobernar el ciclo de vida de la información institucional, garantizando que pueda ser identificada, organizada, contextualizada, preservada, consultada y transferida entre proyectos, responsables y periodos de dirección.</documentation>
      </element>
      <element xsi:type="archimate:Capability" name="Defensa y Gobernanza Territorial" id="id-933ae56886804b47a56df62c25cee0d1">
        <documentation>Capacidad para conocer, planificar, gestionar y defender el territorio campesino y los derechos asociados a la tierra.</documentation>
      </element>
      <element xsi:type="archimate:Capability" name="Economía campesina, social y solidaria" id="id-cf811dd73b814e7997a3d34fbcf39985">
        <documentation>Capacidad para desarrollar y fortalecer formas económicas campesinas, familiares, comunitarias y solidarias que contribuyan a la autonomía económica de las comunidades.</documentation>
      </element>
      <element xsi:type="archimate:Capability" name="Educación y formación comunitaria" id="id-7ab21fec0db1475ab8fc632a4425dfb5">
        <documentation>Capacidad para desarrollar procesos educativos y formativos que fortalezcan liderazgo, conocimientos, autonomía y participación comunitaria.</documentation>
      </element>
      <element xsi:type="archimate:Capability" name="Gestión de alianzas, redes y cooperación" id="id-feb5d0d83f464a859becc91602aea6fe">
        <documentation>Capacidad para construir, mantener y movilizar relaciones con organizaciones sociales, universidades, instituciones públicas, ONG, cooperación y otros actores estratégicos.</documentation>
      </element>
      <element xsi:type="archimate:Capability" name="Cultura, identidad, recreación y bienestar" id="id-a1c467b6d4fd49df994a43e43496f780">
        <documentation>Capacidad para fortalecer identidad, cultura, vínculos comunitarios, prácticas recreativas y expresiones propias del campesinado.</documentation>
      </element>
      <element xsi:type="archimate:Capability" name="Gestión jurídica y cumplimiento institucional" id="id-ac16f30f01034b5ea400e41ed3b338cd">
        <documentation>La capacidad de apoyar en procesos de participación popular para tener voz en entidades gubernamentales. </documentation>
      </element>
      <element xsi:type="archimate:Capability" name="Capacidades habilitadoras y de soporte" id="id-f76cf3e613d3477b986b7c9dde306925"/>
      <element xsi:type="archimate:Capability" name="Comunicación comunitaria e incidencia pública" id="id-840d1938963b4598890304f43f00e60c">
        <documentation>Capacidad para producir, gestionar y difundir comunicación propia que fortalezca la organización, la participación, la memoria, la incidencia y la identidad campesina.</documentation>
      </element>
      <element xsi:type="archimate:Capability" name="Defensa de derechos humanos y protección comunitaria" id="id-86ffe2b661624ccb843fecd301207573">
        <documentation>Capacidad para prevenir, identificar, documentar, acompañar y articular respuestas frente a situaciones de vulneración de derechos y riesgos que afectan a personas, comunidades y liderazgos campesinos.</documentation>
      </element>
      <element xsi:type="archimate:Capability" name="Desarrollo agroecológico y soberanía alimentaria" id="id-2f32dd3f529e47f1aa9c4b7861cbc59b">
        <documentation>Capacidad para fortalecer sistemas productivos campesinos mediante prácticas agroecológicas, diversidad productiva y reducción de dependencias externas.</documentation>
      </element>
      <element xsi:type="archimate:Capability" name="Direccionamiento y gobernanza organizativa" id="id-6cdbc19ecf6945a2b5e22c166f4c36fc">
        <documentation>Capacidad para orientar estratégicamente la ACIT, definir prioridades, tomar decisiones colectivas, asignar responsabilidades y realizar seguimiento al cumplimiento de las apuestas organizativas.</documentation>
      </element>
      <element xsi:type="archimate:Capability" name="Gestión administrativa y financiera" id="id-59959378355343d4b68efdd0146193c4">
        <documentation>Capacidad para administrar de forma controlada los recursos financieros y administrativos requeridos para el funcionamiento de ACIT y sus proyectos e iniciativas.</documentation>
      </element>
      <element xsi:type="archimate:Capability" name="Gestión ambiental y cuidado comunitario del territorio" id="id-341bcd982d78454d977e86564630ea06">
        <documentation>Capacidad para conocer, conservar, restaurar y gestionar comunitariamente los bienes naturales y ecosistemas del territorio campesino.</documentation>
      </element>
      <element xsi:type="archimate:Capability" name="Gestión de activos y recursos organizacionales" id="id-7052f10a89a04ec495b9a4813024359c">
        <documentation>Capacidad para identificar, controlar y preservar los bienes muebles, inmuebles, equipos e infraestructura bajo responsabilidad de ACIT.</documentation>
      </element>
      <element xsi:type="archimate:Capability" name="Gestión de proyectos, convenios e iniciativas" id="id-955c0020c8224740bc7017ef9693af0a">
        <documentation>Capacidad para identificar oportunidades, formular, administrar, hacer seguimiento y cerrar proyectos y convenios, preservando además la experiencia acumulada de la organización.</documentation>
      </element>
      <element xsi:type="archimate:Capability" name="Incidencia, representación y participación política" id="id-0e748e095be94f15b930adffd004bc19">
        <documentation>Capacidad para representar los intereses campesinos, incidir ante instituciones y escenarios políticos y fortalecer la participación comunitaria en decisiones relacionadas con el territorio y los derechos campesinos.</documentation>
      </element>
      <element xsi:type="archimate:Capability" name="Investigación, conocimiento y memoria campesina" id="id-e2b1327ef7134838966ad86f80edd339">
        <documentation>Capacidad para investigar, producir, sistematizar, preservar y reutilizar conocimientos generados por la organización, las comunidades y sus procesos de cooperación académica.</documentation>
      </element>
    </folder>
    <folder name="Recursos" id="id-23d8594be62b4550a222ebaf866ff927">
      <element xsi:type="archimate:Resource" name="Información de procesos campesinos" id="id-2708d9c949b44911973458dc9449f877"/>
      <element xsi:type="archimate:Resource" name="Recursos de información y conocimiento" id="id-b3eff15ec309454e996b4ce390c6f54b"/>
      <element xsi:type="archimate:Resource" name="Recursos financieros" id="id-7fd80e02279545dc8bca7490e0997a79"/>
      <element xsi:type="archimate:Resource" name="Recursos humanos y organizativos" id="id-faec9db711e74f278c274231e4f24c02"/>
      <element xsi:type="archimate:Resource" name="Recursos relacionales" id="id-89dd56c785d2457b95406d91d470edd1"/>
      <element xsi:type="archimate:Resource" name="Recursos tecnológicos" id="id-8b94c2c1bac34f629bdb2a1325e90cf2"/>
      <element xsi:type="archimate:Resource" name="Recursos territoriales y físicos" id="id-9bd81997342a4218b1e90ba8789c72fa"/>
    </folder>
    <folder name="Flujo de valor" id="id-567d192d00974419943a1fcb9a0ed756">
      <element xsi:type="archimate:ValueStream" name="Del conocimiento disperso a la gobernanza de la información" id="id-30d49aae8e164f6bae1ecccf10a9c962">
        <documentation>Se pretende pasar de tener la información dispersa y descentralizada a custodiada y accesible</documentation>
      </element>
      <element xsi:type="archimate:ValueStream" name="Información y datos recopilados" id="id-e2abb90be03c44af980a7cf2324b9e3c">
        <documentation>Se recopila la información que tenga en sus dispositivos o nube personal</documentation>
      </element>
      <element xsi:type="archimate:ValueStream" name="Ubicación de la información Identificada" id="id-6883f8aae19f43e99fe0ccd1a545c8ab">
        <documentation>Se identifica quién almacena qué información, documentos o archivos relacionados con determinado proceso o proyecto</documentation>
      </element>
      <element xsi:type="archimate:ValueStream" name="Información clasificada y documentada" id="id-b3dcaac4015c487a99d4daae7c9ef4fc">
        <documentation>Se clasifica la información recopilada y se documenta qué tipo de información es por clasificaciones.&#xD;
- Sensible&#xD;
- Ambiental&#xD;
- Territorial&#xD;
- DDHH.. etc</documentation>
      </element>
      <element xsi:type="archimate:ValueStream" name="Continuidad frente al cambio implementada" id="id-b8ce97955edb4eba95e702493d483d9f"/>
      <element xsi:type="archimate:ValueStream" name="Del cambio de responsable a la continuidad organizacional" id="id-ac149e8a0c7845888f4e2492d1359cc9"/>
      <element xsi:type="archimate:ValueStream" name="Del riesgo de la información a la protección y seguridad" id="id-578178e29b2b4f0683f5080b4b584ca6"/>
      <element xsi:type="archimate:ValueStream" name="Información almacenada y centralizada" id="id-932867c7eb7a41dcb93dd5852944a09f">
        <documentation>Se almacena la información en un mismo lugar para la ACIT.</documentation>
      </element>
      <element xsi:type="archimate:ValueStream" name="Información cifrada y clasificada" id="id-4a3870cc59df48d8855b382aea21716c">
        <documentation>Se clasifica y cifra la información sensible</documentation>
      </element>
      <element xsi:type="archimate:ValueStream" name="Información relevante almacenada" id="id-d9f0aab3e42140278e1960294362e70d"/>
      <element xsi:type="archimate:ValueStream" name="Información relevante documentada" id="id-745ffdd5ea3d4ed29fe12b562438dd60">
        <documentation>Se documenta la información y el conocimiento particular que se tenga del proceso</documentation>
      </element>
      <element xsi:type="archimate:ValueStream" name="Información sensible identificada" id="id-7994e21110dd470d833719869779cc0c">
        <documentation>Se identifica la información y datos que son de crucial protección</documentation>
      </element>
      <element xsi:type="archimate:ValueStream" name="Información y documentos sistematizados" id="id-eec19d1dece64ed786880cdcfa739485">
        <documentation>se sistematiza para facilitar su búsqueda</documentation>
      </element>
      <element xsi:type="archimate:ValueStream" name="Protección de información sensible implementada" id="id-e2f879b3776542df86f2bc16d1286a18">
        <documentation>Se implementa la protección de la información sensible dentro de la ACIT</documentation>
      </element>
      <element xsi:type="archimate:ValueStream" name="Responsable de proceso identificado" id="id-d85a84fc764f4dbcb44f84e4f53a1873">
        <documentation>Se identifican las personas encargadas de un proceso que conservan conocimientos e información de manera individual.</documentation>
      </element>
      <element xsi:type="archimate:ValueStream" name="Roles de seguridad identificados" id="id-17ae89fdecb248ffb5099efdacbeee85">
        <documentation>Se identifican los roles que deben haber dentro de la organización para el acceso a la información sensible y protegida</documentation>
      </element>
    </folder>
  </folder>
  <folder name="Business" id="id-c3be6c0a33344a908cd545f20da323eb" type="business">
    <folder name="Actores" id="id-19f676f8f0f047d0909276c6a87e45ff"/>
    <folder name="Procesos" id="id-15285153ecdc405888d07584f51478e9">
      <folder name="Macroprocesos" id="id-a6c84baed77f482c8275940e24fb2b36">
        <folder name="Administrativos" id="id-f0de0cea6b2e446da25efd8ec82dd6f6">
          <element xsi:type="archimate:BusinessProcess" name="Gerenciar personería jurídica ACIT" id="id-bfa214cec3244518b0c1d85ef4027ca4">
            <documentation>Proceso mediante el cual se administran los aspectos legales de la organización, asegurando el cumplimiento de los requisitos normativos, la actualización de la personería jurídica y el mantenimiento de la documentación requerida para el funcionamiento institucional. </documentation>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Gestionar la adminitración financiera" id="id-6ebf8341e59744eaa15fbc4333e10246">
            <documentation>Proceso orientado a planificar, administrar y controlar los recursos financieros de la organización, garantizando su adecuada ejecución, transparencia y sostenibilidad institucional.</documentation>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Gestionar la documentación legal territorial" id="id-e2a82962bf084bf880cdd7e1bd29ed47">
            <documentation>Proceso encargado de organizar, custodiar y actualizar la documentación relacionada con los procesos jurídicos y territoriales desarrollados por la asociación, facilitando el acceso a la información y el acompañamiento a las comunidades. </documentation>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Gestionar la información  institucional" id="id-b7bc7ca1473e4069bd0973160b8d265e">
            <documentation>Proceso orientado a recopilar, organizar, almacenar y preservar la información generada por la organización, fortaleciendo la memoria institucional y apoyando la toma de decisiones. </documentation>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Ejecutar caracterización multidimensional" id="id-18701ee575bf412d84bbf9dc9230c7d9">
            <documentation>Caracterización de la ZRC ejecutado en paralelo por los equipos de Tierra, Ambiental, Económico-Productivo, Social e Histórico</documentation>
          </element>
        </folder>
        <folder name="Estrategicos" id="id-f9d90da9053244639748b8a69763ea5d">
          <element xsi:type="archimate:BusinessProcess" name="Articular convenios  y financiamiento de proyectos" id="id-24a0554ad928478f8ecba1af25689bc8">
            <documentation>Proceso mediante el cual la ACIT establece relaciones de cooperación con entidades públicas, privadas, organizaciones sociales y organismos de cooperación para obtener financiamiento de iniciativas y formular proyectos que permitan gestionar recursos para el fortalecimiento organizativo, territorial, productivo, ambiental y social de la asociación. </documentation>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Gestionar el Plan de Desarrollo Sostenible" id="id-9607b9c5e0704bfa9cfb0f97a0367217">
            <documentation>Proceso orientado a coordinar la formulación, actualización, seguimiento y articulación del Plan de Desarrollo Sostenible (PDS) como instrumento de planificación participativa de la Zona de Reserva Campesina, promoviendo la ejecución de sus líneas estratégicas y el cumplimiento de los objetivos definidos por las comunidades campesinas</documentation>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Gestionar la organización comunitaria" id="id-8aa199525c16477bafc94eccf374ef95">
            <documentation>Proceso encargado de fortalecer la estructura organizativa de la asociación mediante la coordinación de espacios de participación, la articulación entre las diferentes instancias organizativas y el acompañamiento a los procesos comunitarios desarrollados en el territorio.</documentation>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Atender solicitudes de subsanación" id="id-9db4043b71a24ae1a32edafae9a09877"/>
          <element xsi:type="archimate:BusinessProcess" name="Aprobar proyecto" id="id-62ff1d7baad24869b74eb62041305969"/>
          <element xsi:type="archimate:BusinessProcess" name="Desginar responsable" id="id-1ab999179c3f4efb842a3be222f83e23"/>
          <element xsi:type="archimate:BusinessProcess" name="Formular proyecto asociado" id="id-13d3da10307f4d84ad6dea97d12ee3b5"/>
          <element xsi:type="archimate:BusinessProcess" name="Generar formatos de registro a convocatoria" id="id-7c9fe10a46824ebe98b052c0614aceac"/>
          <element xsi:type="archimate:BusinessProcess" name="Recopilar documentos solicitados" id="id-faa74ecc71ba4e54911934234864eac3"/>
          <element xsi:type="archimate:BusinessProcess" name="Revisar requisitos de evaluación" id="id-e647c7ab532447b5b681013560e78e9d"/>
          <element xsi:type="archimate:BusinessProcess" name="Verificar criterios habilitantes" id="id-fa404f9d626444d3b96fedf24c2c59ea"/>
          <element xsi:type="archimate:BusinessProcess" name="Gestionar cooperación y financiación" id="id-d6dbb98c019e4e79b2217ddd9e2287bd">
            <documentation>Financia el equipo técnico ante la falta de presupuesto estatal</documentation>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Generar productos asociados a la ZRC" id="id-d280cfc3294f406e95adf7adfb74b05b"/>
          <element xsi:type="archimate:BusinessProcess" name="Emitir comunicado" id="id-7d01b7f2ef3c4eb483d773b0e2182a0f"/>
          <element xsi:type="archimate:BusinessProcess" name="Enviar interesados" id="id-9ac13dde7a484bd79503ec26e47d7e16"/>
          <element xsi:type="archimate:BusinessProcess" name="Enviar transporte a zonas" id="id-572caa5d684544c48aaa21fe3ee8bcb7"/>
          <element xsi:type="archimate:BusinessProcess" name="Gestionar logística" id="id-d57170d94428455ca3f67f99c965516b"/>
          <element xsi:type="archimate:BusinessProcess" name="Informar a entidad de convenio" id="id-dfb8e256186e427dbf7f4774bfa71bef"/>
        </folder>
        <folder name="Misionales" id="id-9d4333d0edaa46eeae11c3bfc9a205fd">
          <folder name="Gestion territorial" id="id-ad0716402ef34335a8ed75d0d605e3c8">
            <element xsi:type="archimate:BusinessProcess" name="Acompañar los procesos de regularización de tierras" id="id-7e4bf778244348bf9ab89c96000d4db0">
              <documentation>Proceso orientado a brindar acompañamiento a las comunidades en los procesos de formalización, adjudicación, restitución y demás mecanismos relacionados con la seguridad jurídica de la propiedad rural.</documentation>
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Articular los instrumentos de planificación territorial" id="id-2f0385247e7a403b96525c67ac1eaf91"/>
            <element xsi:type="archimate:BusinessProcess" name="Acompañar procesos jurídicos y de defensa territorial" id="id-bb0c1999a30f44b9b6e9dc5ad20b3998">
              <documentation>Proceso mediante el cual la ACIT acompaña la gestión de procedimientos jurídicos y administrativos relacionados con la defensa del territorio y la garantía de los derechos campesinos. Comprende el seguimiento a trámites ante entidades públicas, la preparación y radicación de solicitudes, recursos y acciones jurídicas cuando son necesarias, así como la articulación con organizaciones y profesionales que brindan apoyo técnico y jurídico para fortalecer los procesos colectivos.</documentation>
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Censar y caracterizar la tenencia de la tierra" id="id-2120f67da3ff486fbe1b9b329dda3ccc">
              <documentation>Proceso encargado de recopilar, organizar y analizar información sobre las condiciones de tenencia de los predios rurales, apoyando la toma de decisiones y los procesos de ordenamiento territorial.</documentation>
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Coordinar la gestión de la Zona de Reserva Campesina" id="id-485c27e4e2ca45d08f4622cbae5e06e4">
              <documentation>Proceso mediante el cual se desarrollan acciones orientadas a la consolidación, seguimiento y fortalecimiento de la Zona de Reserva Campesina como instrumento de ordenamiento territorial y permanencia campesina. </documentation>
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Mediar conflictos territoriales" id="id-577f022c5093477984c557ff38a27458">
              <documentation>Proceso mediante el cual se promueven espacios de diálogo, conciliación y concertación para la resolución pacífica de conflictos relacionados con la tenencia, uso y administración del territorio.</documentation>
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Analizar restricciones ambientales" id="id-66e552df970c40cda85826c7c68518d4">
              <documentation>(Ley Segunda de 1952): Verificar si el predio está protegido, lo cual legalmente impide que la ANT lo pueda adjudicar.</documentation>
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Clasificar jurídicamente predios" id="id-c486864733884e89ae3b4926432f0468">
              <documentation>Determinar qué tipo de tierra es y qué proceso requiere</documentation>
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Evaluar determinantes ambientales" id="id-bd44a761322a49679cdb86f94d65f867">
              <documentation>Revisar afectaciones ecológicas generales.</documentation>
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Realizar estudio agronómico" id="id-bcdb20302e3941d7b72aefa5956a5a56">
              <documentation>Evaluar el suelo y las condiciones del predio para certificar ante la ANT que la tierra es viable para ser trabajada.</documentation>
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Caracterizar la poblacional y su autoidentificación" id="id-933485b22e1949918dfda3f31f81e7ad">
              <documentation>Identificar si los habitantes se reconocen como indígenas, campesinos o ambos</documentation>
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Gestionar los entornos educativos" id="id-bc0e24d90b854561927aeaf81bb31333">
              <documentation>Intervenir en las tensiones de las escuelas veredales, donde existe un interés económico y político por imponer modelos de etnoeducación indígena.</documentation>
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Mediar en tensiones territoriales y culturales" id="id-80d9baea68814c58abf9ea5f9c9d4b2e">
              <documentation>Manejar situaciones de presión por la constitución de resguardos, la afiliación forzada a cabildos o la delimitación de tierras</documentation>
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Relacionar Predio-Tenencia" id="id-61e42711f6f744cd8dbb7fdf3341cbb7">
              <documentation>Cruzar la información geoespacial con la persona que ejerce la tenencia y su identidad cultural</documentation>
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Delegar encargados y profesionales" id="id-74f06854767c4e989d0d6a86dbba6bc6"/>
            <element xsi:type="archimate:BusinessProcess" name="Establecer zona" id="id-cc298eda9e3846b28dc0ecd0bdedcf27"/>
            <element xsi:type="archimate:BusinessProcess" name="Generar datos de censo y caracterización" id="id-e2129e57cf32422a958ec128e302a907"/>
            <element xsi:type="archimate:BusinessProcess" name="Gestionar la relación con la ANT" id="id-66527afef4bd4b53b7838c6a5b949101"/>
            <element xsi:type="archimate:BusinessProcess" name="Identificar finalidad del terreno" id="id-5435a264879840c0b4aa37ded3e4fcdf"/>
            <element xsi:type="archimate:BusinessProcess" name="Integrar la información territoriail para la toma de decisiones" id="id-7108bedb0a6240aba119be67bb99e263"/>
            <element xsi:type="archimate:BusinessProcess" name="Hacer seguimiento a los procedimientos" id="id-a19028d3eb814cf09d26fb5805d6903d"/>
            <element xsi:type="archimate:BusinessProcess" name="Identificar marco jurídico aplicable" id="id-99faa47426394f9881e35f0ae401aa91"/>
            <element xsi:type="archimate:BusinessProcess" name="Preparar documentación requerida" id="id-8199e0c082e04ad6aba4092002f498bf"/>
            <element xsi:type="archimate:BusinessProcess" name="Radicar solicitudes ante entidades competentes" id="id-dfae85bd9f80425798c2d3b743752f09"/>
            <element xsi:type="archimate:BusinessProcess" name="Usar recursos y acciones constitucionales" id="id-8f8e7476be654c2799b6589cd8f45277"/>
          </folder>
          <folder name="Educaciónm, cultura y bienestar" id="id-5250ba9905364feca3b669dbbb50e0dc">
            <element xsi:type="archimate:BusinessProcess" name="Desarrollar formación política y organizativa campesina" id="id-5ebfc03952604e7098af9f40291087bb">
              <documentation>Comprende la identificación de necesidades de formación política y organizativa, la construcción de contenidos a partir de los principios, trayectoria y apuestas de la ACIT, y el desarrollo de espacios pedagógicos orientados a fortalecer la comprensión crítica del territorio, los derechos campesinos, la organización, la participación y la acción colectiva. Busca que los conocimientos técnicos o especializados sean interpretados desde las necesidades históricas y principios políticos de la organización.</documentation>
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Sistematizar y producir conocimiento campesino" id="id-3147417ebc1145ed83a8d535f287b263">
              <documentation>Comprende la recuperación, organización, documentación, análisis y producción colectiva de conocimientos derivados de la trayectoria, experiencias, investigaciones, conversaciones y prácticas de la organización campesina, con el propósito de preservar su memoria, generar conocimiento propio y fortalecer la capacidad investigativa de la ACIT sobre sus realidades territoriales, políticas, organizativas y culturales.</documentation>
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Desarrollar procesos comunitarios de formación temática" id="id-b469c874a8c54ac1a3b5ea8bb2317db6">
              <documentation>Comprende el diseño y ejecución de procesos pedagógicos especializados promovidos por los diferentes comités, proyectos y espacios organizativos de la ACIT, mediante los cuales se fortalecen conocimientos y capacidades comunitarias en ámbitos como comunicación popular, ambiente, deporte, derechos, género, producción y otras áreas vinculadas a las necesidades del territorio.</documentation>
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Desarrollar formación técnica y cualificación para el trabajo campesino" id="id-62b4989a2d7d418e9a9dd0198efbbab8">
              <documentation>Comprende la identificación de necesidades de cualificación técnica de las comunidades, la articulación con instituciones educativas y entidades de formación, la gestión y divulgación de ofertas y el desarrollo de procesos formativos relacionados con actividades agrícolas, comerciales, de servicios, transformación de productos y otras competencias aplicables a la economía y vida campesina.</documentation>
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Espacios de capacitación" id="id-11cf2f5b24e9426487c8b63af0367342"/>
            <element xsi:type="archimate:BusinessProcess" name="Formación política" id="id-b5254f41e8414e90a182b2edbcfc363e"/>
            <element xsi:type="archimate:BusinessProcess" name="Coordinar acciones comunitarias de conservación y restauración ecológica" id="id-dc3852de318d47198a5cdbf3f7976424">
              <documentation>Siembra de frailejones, árboles y recuperación de semillas nativas</documentation>
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Gestión de contenidos comunitarios" id="id-9227dff6844441de973c78169640b5be"/>
            <element xsi:type="archimate:BusinessProcess" name="Fortalecer la educación ambiental comunitaria" id="id-1e0a2121f5bf4b8184ad226fd29c020c">
              <documentation>Charlas, recorridos, muralismo, campañas de consciencia y cultura ambiental para la sensibilización y promoción de prácticas de conservación ambiental con niños, niñas, adolescentes, jóvenes, líderes, lideresas y la conversa con los abuelos.</documentation>
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Formación comunitaria" id="id-2a086df617ac45ada296cd82ec7169a2"/>
            <element xsi:type="archimate:BusinessProcess" name="Gestión del conocimiento" id="id-030509e2896446688b7ccae6f8325859"/>
            <element xsi:type="archimate:BusinessProcess" name="Investigación comunitaria" id="id-4e6d2813972047968a692e3da224ff2b"/>
            <element xsi:type="archimate:BusinessProcess" name="Realizar monitoreo comunitario de la biodiversidad" id="id-02fca3cd5fa64287b074ea7783fa9c0d">
              <documentation>Identificación y avistamiento de especies.</documentation>
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Abrir espacios de opinión" id="id-cf76d4fffa374b319c2159a8025da22e"/>
            <element xsi:type="archimate:BusinessProcess" name="Comunicar temas de educación campesina" id="id-d12ee7551dab4fe58b26ebe28f687a86"/>
            <element xsi:type="archimate:BusinessProcess" name="Difundir información organizativa" id="id-7beeb052350846d4a00a2789fe6c840a"/>
            <element xsi:type="archimate:BusinessProcess" name="Documentar experiencias" id="id-c989254b3edc41448ad7a1bc38664d76"/>
            <element xsi:type="archimate:BusinessProcess" name="Transmitir la identidad campesina" id="id-9796380274f247ffac223bb059dbd054"/>
            <element xsi:type="archimate:BusinessProcess" name="Desarrollar recorridos pedagógicos" id="id-de3d216b19484b3b952325b846be234b"/>
            <element xsi:type="archimate:BusinessProcess" name="Organizar jornadas ambientales" id="id-3dfaa13fc070498da93fda06c3968e86"/>
            <element xsi:type="archimate:BusinessProcess" name="Recuperación de semillas nativas" id="id-ae349100533648bfb6bef69924795cb3"/>
            <element xsi:type="archimate:BusinessProcess" name="Restauración de nacimientos de agua" id="id-ed544c6d60424619ac2d5cc4ba79c55a"/>
          </folder>
          <folder name="Desarrollo productivo" id="id-7cf0760760cd47448dda393fd167dadd">
            <element xsi:type="archimate:BusinessProcess" name="Transformar productos campesinos y generar valor agregado" id="id-37a3993605624a128fd2a5c609abe717">
              <documentation>Comprende los procesos de acondicionamiento, procesamiento y transformación de productos agrícolas y agroalimentarios para ampliar sus posibilidades de uso, conservación y comercialización. Incluye experiencias de transformación de café, alimentos, plantas, especias y otros productos derivados de la producción campesina.</documentation>
            </element>
          </folder>
        </folder>
      </folder>
      <folder name="Otros" id="id-9e89b4597e0a4aa59098bdb154386539"/>
    </folder>
