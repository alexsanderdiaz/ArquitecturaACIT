  <folder name="Application" id="id-a452fff539a3475aac404e8c02aff8f4" type="application">
    <element xsi:type="archimate:ApplicationComponent" name="Sistema de Información Territorial Campesino" id="id-2d43485b0e1b44f38d15ac6bbce1bc96"/>
