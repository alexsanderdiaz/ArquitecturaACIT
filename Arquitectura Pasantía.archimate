        <element xsi:type="archimate:CourseOfAction" name="Curso de Acción" id="id-9257e3b0f73945179cdf39671d34ed71"/>
      </folder>
      <element xsi:type="archimate:CourseOfAction" name="Estrategia: Procesos para el reconocimiento institucional como sujeto campesino de derechos" id="id-b1a9f7b4c9d849f9b1165b8a381727ba"/>
      <element xsi:type="archimate:CourseOfAction" name="Táctica: Procesos de apropiación y defensa, censos socioterritoriales y documentación." id="id-8d25158c84c047ed8cf330f4c722f62a"/>
      <element xsi:type="archimate:CourseOfAction" name="Alianzas y proceso de articulación colectiva" id="id-e403eae88b58436dae0b1af9bc03aea8">
        <documentation>Construcción de tejido social por medio del ejercicio de juntanza entre grupos para fortalecer redes y procesos campesinos</documentation>
      </element>
      <element xsi:type="archimate:CourseOfAction" name="Unificación y uso compartido de la información" id="id-4cfe992b40dd4761bbc9104f9198d7a3"/>
