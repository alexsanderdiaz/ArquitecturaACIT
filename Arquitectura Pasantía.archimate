        <child xsi:type="archimate:Note" id="id-a9b6c387dcd74ec58473fed1e6ae8e86" targetConnections="id-70f26155fd974dacb711a09ef5e30075" textAlignment="1">
          <bounds x="276" y="852" width="145" height="156"/>
          <content>Transmite:&#xD;
- Formación política.&#xD;
- Derechos campesinos.&#xD;
- Normatividad.&#xD;
- Agricultura.&#xD;
- Economía solidaria.&#xD;
- Historia.&#xD;
- Cultura.&#xD;
- Medio ambiente.</content>
        </child>
        <child xsi:type="archimate:Note" id="id-01d036aa222b4f6785bd5d7304831385" targetConnections="id-b8a1b8d45f534db09813f0165656ecdb" textAlignment="1">
          <bounds x="432" y="852" width="159" height="80"/>
          <content>Entrevistar líderes.&#xD;
Registrar historias.&#xD;
Documentar experiencias.&#xD;
Difundir memoria histórica.</content>
        </child>
        <child xsi:type="archimate:Note" id="id-98d872820ec74af5aea311d06544bb21" targetConnections="id-80d4782fe0d74629bd12597167c962d2" textAlignment="1">
          <bounds x="600" y="852" width="137" height="111"/>
          <content>Transmite:&#xD;
- Música.&#xD;
- Tradiciones.&#xD;
- Gastronomía.&#xD;
- Historia.&#xD;
- Lenguaje campesino.</content>
        </child>
        <child xsi:type="archimate:DiagramObject" id="id-a7ce6d9f41374a0b9f02dc7400b651b9" archimateElement="id-6e1c3849ede44be49e230fb2a14c12dd">
          <bounds x="1173" y="330" width="120" height="55"/>
