  <folder name="Technology &amp; Physical" id="id-52baf3dae6a9412da4f7980f558cee84" type="technology"/>
  <folder name="Motivation" id="id-aba84e07c77b4289b2cf81dcc26ffb9e" type="motivation">
    <folder name="Interesados" id="id-14b374365d8c4e989d9509a4317eec13">
      <element xsi:type="archimate:Stakeholder" name="Asamblea Campesina " id="id-8f11a29fa7f645d0a4382ee237428004"/>
      <element xsi:type="archimate:Stakeholder" name="Colectivos" id="id-714e884a55af4fd69d68a5e733c55fa6"/>
      <element xsi:type="archimate:Stakeholder" name="Comités" id="id-affdbebac4e347db9e371ac46776750d"/>
      <element xsi:type="archimate:Stakeholder" name="Directiva Central" id="id-77d237e8ea034bd0a24e5ec38cc4b1b8"/>
      <element xsi:type="archimate:Stakeholder" name="JAC Veredales" id="id-886c38b3b3214f3cb6280364f6ce7ab5"/>
      <element xsi:type="archimate:Stakeholder" name="Subdirectivas Zonales" id="id-e9743d7156074586a0cf1ea15287959e"/>
    </folder>
    <folder name="Objetivos" id="id-503e062d568b477bb1b5201568daf28d">
      <folder name="Otros" id="id-e5020556cba24a3f94c9cdf8e64724ad">
        <element xsi:type="archimate:Goal" name="Objetivos Deseados" id="id-48e59f1bd3b341858c6ec6bbb88953d3"/>
      </folder>
      <element xsi:type="archimate:Goal" name="Consolidación de una gobernanza territorial intercultural" id="id-a070546e75c84be193da9e5aee1de22c">
        <documentation>Fortalecer un modelo de gobernanza territorial basado en la participación democrática, el diálogo intercultural y el reconocimiento equitativo de los diferentes actores del territorio, garantizando la incidencia del campesinado en la toma de decisiones sobre el desarrollo territorial.</documentation>
      </element>
      <element xsi:type="archimate:Goal" name="Fortalecimiento de la identidad y la cultura campesina" id="id-dbf8879bd1f64892a418becee051dfb1">
        <documentation>Preservar, fortalecer y promover la identidad campesina mediante la protección de los saberes, las prácticas culturales, la memoria histórica y las expresiones sociales que fortalecen el sentido de pertenencia y la permanencia en el territorio. </documentation>
      </element>
      <element xsi:type="archimate:Goal" name="Consolidación de un territorio para la permanencia campesina" id="id-d4f41a9dd22f482d919c1bdd2a6dcac7">
        <documentation>Promover un modelo de desarrollo territorial que garantice la permanencia digna de las comunidades campesinas, fortaleciendo la seguridad jurídica sobre la tierra, la función social del territorio y la sostenibilidad de los medios de vida rurales.</documentation>
      </element>
      <element xsi:type="archimate:Goal" name="Reconocimiento del Campesino como sujeto  político de derechos y de especial protección constitucional" id="id-190742200dc54a73a102c1e15ddf91ab">
        <documentation>Alcanzar el reconocimiento del campesinado como sujeto colectivo de derechos, con identidad, cultura y formas propias de organización, fortaleciendo su participación política y su incidencia en la formulación de políticas públicas y en la gestión del territorio.</documentation>
      </element>
      <element xsi:type="archimate:Goal" name="Garantizar la soberanía, integridad y acceso a la información" id="id-0ed45a94ea7e455592dfb4fb904e88d9">
        <documentation>Asegurar la protección, integridad, disponibilidad y acceso colectivo a la información institucional y territorial, promoviendo su administración por parte de la propia organización y fortaleciendo la autonomía en la gestión del conocimiento.</documentation>
      </element>
      <element xsi:type="archimate:Goal" name="Fortalecer la gestión y el reconocimiento de la información territorial" id="id-f7cc4704284c4f0b8d70453ee79b4681">
        <documentation>Consolidar la información generada por la ACIT como un activo estratégico para la organización, fortaleciendo su uso en los procesos de planificación, gestión territorial, formulación de proyectos y toma de decisiones. </documentation>
      </element>
      <element xsi:type="archimate:Goal" name="Misión: Organización, Defensa y Poder Popular" id="id-fdec46cfb4594e42bcaff54f33505b16">
        <documentation>Organizar, fortalecer y representar al campesinado de Inzá mediante procesos de formación, participación y desarrollo comunitario que contribuyan a la defensa del territorio, el fortalecimiento de la economía campesina y la construcción del poder popular.&#xD;
</documentation>
      </element>
      <element xsi:type="archimate:Goal" name="Visión: Autonomía, Soberanía y Reconocimiento Campesino." id="id-7d88eacbd3d84c10a46c7801c61649c7">
        <documentation>Consolidar un territorio campesino autónomo, reconocido como sujeto colectivo de derechos, donde la identidad campesina, la participación comunitaria, la interculturalidad y el poder popular garanticen la permanencia digna de las comunidades en el territorio y el desarrollo sostenible de Inzá.</documentation>
      </element>
    </folder>
    <folder name="Motivadores" id="id-8a8c5770d6af4c508688ab2ef74c90c4">
      <folder name="Otros" id="id-9f4d1069c5a1474bb67f5083d60e79e0">
        <element xsi:type="archimate:Driver" name="Influencia" id="id-33f4387da9bd49bcbb776cfb405bf05d">
          <documentation>Factores que pueden causar cambios en la Organización.</documentation>
        </element>
      </folder>
      <element xsi:type="archimate:Driver" name="Reconocimiento del campesinado como sujeto político de derechos y de especial protección constitucional" id="id-bb0038f5a3834271b966acd804740656">
        <documentation>La necesidad de lograr el reconocimiento político, social y jurídico del campesinado como sujeto colectivo de derechos, fortaleciendo su participación en la formulación de políticas públicas y en la toma de decisiones que afectan el territorio.</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="Fortalecimiento de la identidad y la cultura campesina" id="id-3aad8a5f0b5340bebf3d0d530e7b290f">
        <documentation>La preservación y transmisión de los saberes, prácticas, valores e identidad campesina como elementos fundamentales para garantizar la permanencia cultural, fortalecer el tejido social y consolidar el reconocimiento del campesinado como sujeto histórico y político.</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="Fortalecimiento de la gobernanza y la representación territorial" id="id-1f0304220d7b49458edbc10af99347ca">
        <documentation>La búsqueda de una participación efectiva del campesinado en los espacios de decisión territorial, promoviendo condiciones de representación equitativas que permitan incidir en la planificación, administración y defensa del territorio.</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="Seguridad jurídica y autonomía sobre la tierra" id="id-d51be6e18e584a75ae5252c73e090919">
        <documentation>La necesidad de garantizar el acceso, la permanencia y la seguridad jurídica sobre la tierra, promoviendo un modelo de tenencia basado en su función social, el arraigo territorial y el derecho de las familias campesinas a vivir y producir dignamente en el territorio.</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="Protección del territorio y del liderazgo campesino" id="id-dc7564228305418d90b2e8f7f87fcf21">
        <documentation>La necesidad de fortalecer las capacidades organizativas para la defensa del territorio, la permanencia campesina y la protección de los líderes y comunidades frente a las diferentes amenazas que afectan su integridad y sus procesos organizativos.</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="Autonomía y soberanía de la información territorial" id="id-97fc014b8b0340f4aac1956f50d2f715">
        <documentation>La necesidad de garantizar que la información generada por las comunidades campesinas sea gestionada, protegida y utilizada por la propia organización como un recurso estratégico para la toma de decisiones, la planificación territorial y el fortalecimiento de la autonomía organizativa.</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="Fortalecimiento de la infraestructura organizativa y comunitaria" id="id-52c921214f8f412ca8156763553274f6">
        <documentation>La necesidad de consolidar espacios físicos, tecnológicos y comunitarios que fortalezcan los procesos organizativos, educativos, culturales, productivos y de comunicación impulsados por la ACIT.</documentation>
      </element>
      <element xsi:type="archimate:Driver" name="Fortalecimiento del diálogo intercultural" id="id-830c97aa14274d639b8e6cab70c4372b">
        <documentation>La necesidad de promover mecanismos de diálogo, concertación y construcción colectiva entre las diferentes comunidades presentes en el territorio, favoreciendo relaciones de respeto mutuo y la gestión pacífica de los conflictos interculturales.</documentation>
      </element>
    </folder>
    <folder name="Resultados" id="id-9c7717d68f284786950ea4394c5cff4e">
      <folder name="Otros" id="id-b8d9c34df9564b22a24c3f88cf103848">
        <element xsi:type="archimate:Outcome" name="Impacto Potencial" id="id-cc2060beb6b642bf94206a559f871fcc"/>
      </folder>
      <element xsi:type="archimate:Outcome" name="Justicia social" id="id-0240580e8aba414d93625c6a33411de2"/>
      <element xsi:type="archimate:Outcome" name="Reconocimiento y memoria de la cultura e identidad campesina" id="id-b432edb9afa84e3298030dd47ac96376"/>
      <element xsi:type="archimate:Outcome" name="Permanencia en el territorio propio" id="id-65b52a482c574c3183245425d3528705"/>
      <element xsi:type="archimate:Outcome" name="Riesgo: Perdida de la Información" id="id-81786d4327c24262b9715531097a619c">
        <documentation>Perdida de documentos, registros o deterioro de archivos</documentation>
      </element>
      <element xsi:type="archimate:Outcome" name="Costo: Inversión de tiempo en desplazamientos y procesos manuales" id="id-970ec24f14d142759859adfab0b04d19"/>
      <element xsi:type="archimate:Outcome" name="Riesgo: Perdida de territorio campesino" id="id-f26ea7b9f9aa4585ba83108d3c1b8c60"/>
    </folder>
    <folder name="Evaluaciones" id="id-d0e0e6c847764fe1b89fc3d45960e7d7">
      <folder name="Otros" id="id-fbd3e1466955449e9ebb8d330700a115">
        <element xsi:type="archimate:Assessment" name="Amenazas" id="id-7274f557257841a3933ca035275ece31"/>
        <element xsi:type="archimate:Assessment" name="Análisis DOFA" id="id-2051a2459b684aecafe682828802617f"/>
        <element xsi:type="archimate:Assessment" name="Debilidades" id="id-e34232ffbbfb4ff4bb53b53ded927d75"/>
        <element xsi:type="archimate:Assessment" name="Evaluaciones" id="id-64a8d247819e4c0ba3a099704008253d"/>
        <element xsi:type="archimate:Assessment" name="Externos" id="id-28ea37fef65646fa8388390445cf3860"/>
        <element xsi:type="archimate:Assessment" name="Fortalezas" id="id-d73b029216244d4e9599875d60f4c668"/>
        <element xsi:type="archimate:Assessment" name="Internos" id="id-4c091122f2e342aca7db2c9c8a16a8b0"/>
        <element xsi:type="archimate:Assessment" name="Oportunidades" id="id-6068bb5ca9794119bfc0f7adfdbd6352"/>
      </folder>
      <element xsi:type="archimate:Assessment" name="Debilidad: Participación desigual en la gobernanza territorial" id="id-c9bc3ed54f7247dca4c5138e0790e3f8">
        <documentation>Derivada de diferencias en el reconocimiento jurídico y en el acceso a mecanismos de representación institucional.</documentation>
      </element>
      <element xsi:type="archimate:Assessment" name="Amenaza: Presiones sobre la permanencia en el territorio" id="id-24aa52c712144d1e99b07e80c953099e">
        <documentation>Las presiones institucionales, económicas y los conflictos sobre el uso del territorio representan un riesgo para la permanencia de las comunidades campesinas y el fortalecimiento de su proyecto territorial.</documentation>
      </element>
      <element xsi:type="archimate:Assessment" name="Amenaza: Pérdida del patrimonio cultural campesino" id="id-dfab696f94a84f9f9efb7814b24dcafb">
        <documentation>La disminución en la transmisión de los saberes, prácticas y expresiones culturales campesinas pone en riesgo la preservación de la identidad colectiva.</documentation>
      </element>
      <element xsi:type="archimate:Assessment" name="Debilidad: Reconocimiento limitado del campesinado como sujeto de derechos" id="id-4a7b8cd1a7b84d6592d5e52160b074e9">
        <documentation>Reduce su capacidad de incidencia política y el acceso equitativo a mecanismos de protección y desarrollo territorial.</documentation>
      </element>
      <element xsi:type="archimate:Assessment" name="Fortaleza: Identidad y organización campesina" id="id-9d5803e51bb64e8eb04d328fd26d798c">
        <documentation>La sólida identidad organizativa y cultural del campesinado constituye la base para la defensa del territorio, la participación comunitaria y la preservación de los saberes propios.</documentation>
      </element>
      <element xsi:type="archimate:Assessment" name="Oportunidad: Fortalecimiento del diálogo intercultural" id="id-08fbf5cb65294ab3bd2b8a15593aaea2">
        <documentation>La diversidad cultural del territorio representa una oportunidad para fortalecer procesos de diálogo, concertación y gobernanza intercultural que favorezcan la construcción colectiva del desarrollo territorial.</documentation>
      </element>
      <element xsi:type="archimate:Assessment" name="Riesgo: Ataques Cibernéticos" id="id-7c6f1baa76d94b8f9ae96cdb11b9153a"/>
      <element xsi:type="archimate:Assessment" name="Riesgo: Robo de información sensible" id="id-3f02bdfdaafe4efd900c7d5a61fdce0a"/>
      <element xsi:type="archimate:Assessment" name="Vulnerabilidad: Datos Centralizados" id="id-cb520bf3432a4fb497334fd0270d62b3"/>
      <element xsi:type="archimate:Assessment" name="Vulnerabilidad: Información Dispersa" id="id-16a4db501bb943a798e319c851240686"/>
      <element xsi:type="archimate:Assessment" name="Riesgo: Perdida de la información" id="id-7d9e4413a7fa49d8828becdefe9171e5"/>
      <element xsi:type="archimate:Assessment" name="Amenaza: Conflictos sobre el uso del territorio" id="id-b32e286b67004bd599d412d95792363e">
        <documentation>Las disputas por el acceso y uso del suelo, así como las presiones derivadas de intereses externos, pueden afectar la permanencia de las comunidades campesinas.</documentation>
      </element>
      <element xsi:type="archimate:Assessment" name="Debilidad: Procesos de información parcialmente sistematizados" id="id-42ba134e970749c78d69777a6435afcb">
        <documentation>Gran parte de la información institucional y territorial aún se administra mediante procedimientos manuales y herramientas dispersas, dificultando su consulta, actualización y preservación.</documentation>
      </element>
      <element xsi:type="archimate:Assessment" name="Fortaleza: Organización comunitaria consolidada" id="id-b0606b7c62094d4bb2ebf9bbcc8cb387">
        <documentation>La ACIT cuenta con una estructura organizativa sólida, conformada por la Directiva Central, las subdirectivas zonales, los comités transversales y las Juntas de Acción Comunal Veredales, que facilita la articulación del trabajo comunitario.</documentation>
      </element>
      <element xsi:type="archimate:Assessment" name="Oportunidad: Avances en el reconocimiento de los derechos campesinos" id="id-a3acff5990ec4396b53ad1a7e806a9ba">
        <documentation>Los recientes avances normativos y el reconocimiento progresivo del campesinado como sujeto de especial protección representan una oportunidad para fortalecer la incidencia política y territorial de la ACIT.</documentation>
      </element>
    </folder>
    <folder name="Principios" id="id-4a307e494dfc41dfb079bbd8b2f2700d">
      <folder name="Otros" id="id-914b39d7bacb4a679703170c3b48b714"/>
      <element xsi:type="archimate:Principle" name="Armonía Vital y Territorial" id="id-610c5590f7474d93ba54834f9e682f15">
        <documentation>Respeto a la vida, cuidado del medio ambiente y la tierra como hogar (no como recurso comercial). </documentation>
      </element>
      <element xsi:type="archimate:Principle" name="Cohesión Cultural Comunitaria" id="id-e2d84e3bbe874e7381e01d7fb4303f57">
        <documentation>Actividades culturales (música, deporte, danza) como herramientas de construcción de identidad y comunidad. </documentation>
      </element>
      <element xsi:type="archimate:Principle" name="Gobernanza Territorial Autónoma" id="id-11215fd6c9304bb590466fc88a921539">
        <documentation>Construcción de poder popular, decisión sobre el territorio y ejercicio de la interculturalidad.</documentation>
      </element>
      <element xsi:type="archimate:Principle" name="Pedagogía del Pensamiento Campesino" id="id-6d77d320a0064d6f97c4542bab5f1e2f">
        <documentation>Educación propia, recuperación de saberes y formación para la defensa. </documentation>
      </element>
      <element xsi:type="archimate:Principle" name="La información como bien común y no propiedad individual" id="id-c16894142aa24c9a884c6a3246ef9e86"/>
    </folder>
    <folder name="Requerimientos" id="id-36906f1f36424c798eb9915e0d68efcc">
      <element xsi:type="archimate:Requirement" name="Es necesario un control de acceso a la información" id="id-9323fa60b8224b0d93d7d7c4df92a704"/>
      <element xsi:type="archimate:Requirement" name="Se requiere un acceso compartido para la Asociación" id="id-1d54accebef64c7aa8c1ce6e373a9816"/>
      <element xsi:type="archimate:Requirement" name="Se necesita documentación de la memoria histórica y cultural" id="id-09cc43b1d2d64fed9d3702c8a21f1577"/>
      <element xsi:type="archimate:Requirement" name="Gestión de información y conocimiento para la defensa territorial, jurídica y organizativa." id="id-d9d3eb19212344f8b04646ee22622fe6"/>
      <element xsi:type="archimate:Requirement" name="Es necesario llevar a cabo Procesos de identificación y residencia territorial" id="id-e1f5246840d642d690c44c6e0801868a"/>
      <element xsi:type="archimate:Requirement" name="Se requiere reforzar enfoques de educación y procesos de integración cultural" id="id-b284485a8b854d5d9a7a3040cd67dae0"/>
    </folder>
    <folder name="Valores" id="id-795bc8ad450a416681c420ad01794d45">
      <element xsi:type="archimate:Value" name="Dignidad Campesina" id="id-9f7ab63c26964e178d8e0413ff023bdb"/>
      <element xsi:type="archimate:Value" name="Financiación" id="id-09d915d24a174f5d9debc685ceb8fb5c"/>
      <element xsi:type="archimate:Value" name="Herramientas de defensa territorial" id="id-0d42908c5b1d4e98a1e033f59683e857"/>
      <element xsi:type="archimate:Value" name="Progreso en contexto campesino" id="id-401a699e9bcd46e5942ce56a6dccac50"/>
    </folder>
    <folder name="Restricciones" id="id-fd29a948e2a3410f87d0df6199903cea">
      <element xsi:type="archimate:Constraint" name="Presupuesto" id="id-b6cb3305411c41758bd1ceab82cebbb9">
        <documentation>Recursos limitados y falta de apoyo del estado</documentation>
      </element>
      <element xsi:type="archimate:Constraint" name="Seguridad" id="id-032348ea41604762845082aa418a5b29">
        <documentation>Presiones institucionales, económicas y los conflictos sobre el uso del territorio</documentation>
      </element>
    </folder>
  </folder>
