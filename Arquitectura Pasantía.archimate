        <documentation>Red de Saberes y Dinamizadores.</documentation>
      </element>
      <element xsi:type="archimate:Resource" name="Documentación de casos" id="id-722af2df956540c8a20f057df920a3ff"/>
      <element xsi:type="archimate:Resource" name="Espacios comunitarios" id="id-96736489cdce486bac9524c0de50fa50"/>
      <element xsi:type="archimate:Resource" name="Reconocimiento Legal (Personería jurídica)" id="id-4fdc2df00c6a45ce93816ab327d5d88b"/>
      <element xsi:type="archimate:Resource" name="Tesorería y dirección contable" id="id-b1dffd12cb754b6e85517100803788f8"/>
    </folder>
    <folder name="Flujo de valor" id="id-567d192d00974419943a1fcb9a0ed756">
      <element xsi:type="archimate:ValueStream" name="Cadena de Valor" id="id-30d49aae8e164f6bae1ecccf10a9c962"/>
      <element xsi:type="archimate:ValueStream" name="Construcción y planificación de proyectos para la transformación campesina" id="id-e2abb90be03c44af980a7cf2324b9e3c"/>
      <element xsi:type="archimate:ValueStream" name="Generación de alianzas comunitarias y financiamiento de proyectos campesinos" id="id-6883f8aae19f43e99fe0ccd1a545c8ab"/>
      <element xsi:type="archimate:ValueStream" name="Gobernanza Intercultural y territorio campesino" id="id-b3dcaac4015c487a99d4daae7c9ef4fc"/>
    </folder>
    <element xsi:type="archimate:Capability" name="Formación Técnica" id="id-ec35595fabab48dcac9319550566910a">
      <documentation>Capacidad para fortalecer conocimientos y habilidades técnicas de las comunidades rurales mediante procesos de capacitación relacionados con la producción, la conservación ambiental y otras temáticas de interés comunitario.</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="Gestión del conocimiento Territorial" id="id-6691da2bf4364c918fadd4c2fe534b12">
      <documentation>Capacidad para recopilar, sistematizar, preservar y utilizar el conocimiento generado por las comunidades campesinas y la organización, contribuyendo a la memoria institucional y al desarrollo territorial.</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="Comercialización" id="id-816dc51bcb9e470586c06c577a6a2e4c"/>
    <element xsi:type="archimate:Capability" name="Emprendimientos" id="id-c4f22266bd054973b8c37e4427f22ad7"/>
    <element xsi:type="archimate:Capability" name="Incidencia política" id="id-26c738b6c6f9407b9fe9988999a871d5">
      <documentation>Capacidad para participar en escenarios de diálogo, concertación y formulación de políticas públicas que favorezcan el reconocimiento de los derechos del campesinado y el fortalecimiento de la Zona de Reserva Campesina.</documentation>
    </element>
    <element xsi:type="archimate:Capability" name="Planeación estratégica" id="id-9a643e39dba34085950969eae57fb065">
      <documentation>Capacidad para definir, orientar y evaluar las estrategias institucionales de la ACIT mediante la formulación de objetivos, planes y acciones que permitan cumplir la misión organizacional y fortalecer el desarrollo territorial campesino.</documentation>
    </element>
  </folder>
  <folder name="Business" id="id-c3be6c0a33344a908cd545f20da323eb" type="business">
