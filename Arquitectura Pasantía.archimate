    <folder name="Capacidad" id="id-9c8734dbf4c74118a561164470859032">
      <folder name="Otros" id="id-916d5ea62212428c879e8816a1bca89d">
        <element xsi:type="archimate:Capability" name="Operativo" id="id-9a0dee9aa62d4365bc614c89465d9c9e"/>
        <element xsi:type="archimate:Capability" name="Gestión Organizacional" id="id-30dd4d2792dd4f3ba2ad07497c26bb50"/>
      </folder>
      <element xsi:type="archimate:Capability" name="Capacidad Organizativa" id="id-db39b4a2f7284d32b86018a3d3904957"/>
      <element xsi:type="archimate:Capability" name="Gestión de acceso y datos" id="id-1291effb67504253a26efe067fa5ffbd">
        <documentation>Capacidad para administrar el acceso, almacenamiento, actualización y protección de la información institucional y territorial, garantizando la integridad, disponibilidad y confidencialidad de los datos utilizados por la organización.</documentation>
      </element>
      <element xsi:type="archimate:Capability" name="Gestión de la información de procesos y proyectos" id="id-93e60fb048b548d0b26391318f1237e7">
        <documentation>Capacidad para recopilar, organizar, administrar y mantener la información generada durante la ejecución de proyectos, programas y procesos organizacionales, garantizando su disponibilidad para la toma de decisiones, la rendición de cuentas y la memoria institucional.</documentation>
      </element>
      <element xsi:type="archimate:Capability" name="Fortalecimiento Productivo" id="id-c7775b484e2a40a081d5d457dd603414"/>
      <element xsi:type="archimate:Capability" name="Formación política" id="id-971d3b0081cb47c2b8d311237c708fa5">
        <documentation>Capacidad para promover procesos de formación orientados al fortalecimiento del liderazgo, la participación ciudadana, la defensa de los derechos campesinos y el ejercicio organizativo.</documentation>
      </element>
      <element xsi:type="archimate:Capability" name="Apoyo en procesos de participación popular" id="id-f4d8ae5e7c8a4d3a825ce01dd9739c4b">
        <documentation>Capacidad para promover y acompañar mecanismos de participación ciudadana que fortalezcan la organización comunitaria y la incidencia del campesinado en los asuntos públicos.</documentation>
      </element>
      <element xsi:type="archimate:Capability" name="Mediación de conflictos territoriales" id="id-c282b661c28f40cdb5e59de1a38d27bd">
        <documentation>Capacidad para facilitar mecanismos de diálogo, concertación y mediación comunitaria orientados a la resolución pacífica de conflictos relacionados con el territorio y la convivencia entre actores sociales.</documentation>
      </element>
      <element xsi:type="archimate:Capability" name="Gestión de alianzas institucionales" id="id-d7adba68dfe24c0e99274e840ce48344"/>
      <element xsi:type="archimate:Capability" name="Defensa jurídica territorial" id="id-536a93d8bf4d4fae81ac6c022271f4a1">
        <documentation>Capacidad para brindar acompañamiento jurídico y orientación en la protección de los derechos territoriales de las comunidades campesinas frente a conflictos relacionados con la propiedad, el uso del suelo y el acceso a la tierra.</documentation>
      </element>
      <element xsi:type="archimate:Capability" name="Defensa y Gobernanza Territorial" id="id-933ae56886804b47a56df62c25cee0d1">
        <documentation>Capacidad de defender y apoyar al campesinado en la permanencia en su territorio.</documentation>
      </element>
      <element xsi:type="archimate:Capability" name="Desarrollo Productivo Campesino" id="id-cf811dd73b814e7997a3d34fbcf39985">
        <documentation>Capacidad de apoyar y promover practicas productivas comunitarias campesinas. </documentation>
      </element>
      <element xsi:type="archimate:Capability" name="Economía Campesina" id="id-4c8b16c4c05340d098018f57bfa2b566"/>
      <element xsi:type="archimate:Capability" name="Formación y Gestión del conocimiento" id="id-7ab21fec0db1475ab8fc632a4425dfb5">
        <documentation>Capacidad de generar academia, conocimiento y conservar saberes y prácticas campesinas, apoyar en procesos de formación cultural, deportiva, ambiental y de investigación. </documentation>
      </element>
      <element xsi:type="archimate:Capability" name="Ordenamiento teritorial y social de la propiedad" id="id-89147e53ed6f4d17b09a48164dbc190a">
        <documentation>Capacidad para apoyar procesos de ordenamiento territorial mediante la caracterización de la tenencia de la tierra, la formalización predial y la promoción del uso adecuado del territorio conforme a las necesidades de las comunidades campesinas.</documentation>
      </element>
      <element xsi:type="archimate:Capability" name="Gestión de financiación a iniciativas campesinas" id="id-49cdec4ad9284e0fa186f20618c87082"/>
      <element xsi:type="archimate:Capability" name="Gestión de Cooperación" id="id-feb5d0d83f464a859becc91602aea6fe">
        <documentation>La habilidad de captar recursos y relacionarse con otras entidades. </documentation>
      </element>
      <element xsi:type="archimate:Capability" name="Gestión de Procesos Comunitarios" id="id-a1c467b6d4fd49df994a43e43496f780">
        <documentation>La capacidad de ejecutar talleres y proyectos de diversa índole. </documentation>
      </element>
      <element xsi:type="archimate:Capability" name="Formulación y ejecución de proyectos sociales" id="id-6ce0f014033e44ef97bbc6ba1a1a0b3f"/>
      <element xsi:type="archimate:Capability" name="Gestión de la comunicación comunitaria" id="id-b4e6c1e1e699416fb1f307a36eeab184"/>
      <element xsi:type="archimate:Capability" name="Investigación Campesina" id="id-66cead60b2cf4ad7a8e4f8ee918b0c7d">
        <documentation>Capacidad para desarrollar procesos de investigación participativa sobre las dinámicas territoriales, sociales y productivas del contexto campesino, generando información útil para la toma de decisiones y la formulación de iniciativas comunitarias. </documentation>
      </element>
      <element xsi:type="archimate:Capability" name="Representación campesina frente a entidades gubernamentales" id="id-071279d03300426fb1aa789c56c9c16d">
        <documentation>Capacidad para ejercer la vocería institucional de la ACIT ante entidades gubernamentales y otros actores externos, defendiendo los intereses colectivos de las comunidades campesinas.</documentation>
      </element>
      <element xsi:type="archimate:Capability" name="Representación y Participación Política" id="id-ac16f30f01034b5ea400e41ed3b338cd">
        <documentation>La capacidad de apoyar en procesos de participación popular para tener voz en entidades gubernamentales. </documentation>
      </element>
      <element xsi:type="archimate:Capability" name="Gestión de la documentación legal" id="id-fbd16b12cf3c4f16ae06a405e3fe5b23">
        <documentation>Capacidad para administrar la documentación jurídica e institucional de la organización, asegurando el cumplimiento de los requisitos legales, la conservación de los registros oficiales y la actualización permanente de la personería jurídica y demás obligaciones normativas.</documentation>
      </element>
      <element xsi:type="archimate:Capability" name="Gestión de sostenibilidad financiera" id="id-5466dc53eb984c8eb5a83e03f01f5b33">
        <documentation>Capacidad para administrar los recursos financieros de la organización mediante la planeación presupuestal, el seguimiento financiero y la identificación de mecanismos que garanticen la sostenibilidad económica de la ACIT.</documentation>
      </element>
      <element xsi:type="archimate:Capability" name="Gestión de la ZRC" id="id-2b90f3c387b54aa49f3356eaa506a4a7">
        <documentation>Capacidad para coordinar y fortalecer los procesos de planificación, administración y consolidación de la Zona de Reserva Campesina, articulando las disposiciones normativas con las dinámicas sociales, económicas y ambientales del territorio.</documentation>
      </element>
    </folder>
    <folder name="Recursos" id="id-23d8594be62b4550a222ebaf866ff927">
      <element xsi:type="archimate:Resource" name="Territorio" id="id-2708d9c949b44911973458dc9449f877"/>
