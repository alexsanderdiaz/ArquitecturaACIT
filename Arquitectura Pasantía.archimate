    <folder name="Procesos" id="id-15285153ecdc405888d07584f51478e9">
      <folder name="Macroprocesos" id="id-a6c84baed77f482c8275940e24fb2b36">
        <folder name="Administrativos" id="id-f0de0cea6b2e446da25efd8ec82dd6f6">
          <element xsi:type="archimate:BusinessProcess" name="Gerenciar personería jurídica ACIT" id="id-bfa214cec3244518b0c1d85ef4027ca4">
            <documentation>Proceso mediante el cual se administran los aspectos legales de la organización, asegurando el cumplimiento de los requisitos normativos, la actualización de la personería jurídica y el mantenimiento de la documentación requerida para el funcionamiento institucional. </documentation>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Gestionar la adminitración financiera" id="id-6ebf8341e59744eaa15fbc4333e10246">
            <documentation>Proceso orientado a planificar, administrar y controlar los recursos financieros de la organización, garantizando su adecuada ejecución, transparencia y sostenibilidad institucional.</documentation>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Gestionar la documentación legal territorial" id="id-e2a82962bf084bf880cdd7e1bd29ed47">
            <documentation>Proceso encargado de organizar, custodiar y actualizar la documentación relacionada con los procesos jurídicos y territoriales desarrollados por la asociación, facilitando el acceso a la información y el acompañamiento a las comunidades. </documentation>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Gestionar la información  institucional" id="id-b7bc7ca1473e4069bd0973160b8d265e">
            <documentation>Proceso orientado a recopilar, organizar, almacenar y preservar la información generada por la organización, fortaleciendo la memoria institucional y apoyando la toma de decisiones. </documentation>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Ejecutar caracterización multidimensional" id="id-18701ee575bf412d84bbf9dc9230c7d9">
            <documentation>Caracterización de la ZRC ejecutado en paralelo por los equipos de Tierra, Ambiental, Económico-Productivo, Social e Histórico</documentation>
          </element>
        </folder>
        <folder name="Estrategicos" id="id-f9d90da9053244639748b8a69763ea5d">
          <element xsi:type="archimate:BusinessProcess" name="Articular convenios  y financiamiento de proyectos" id="id-24a0554ad928478f8ecba1af25689bc8">
            <documentation>Proceso mediante el cual la ACIT establece relaciones de cooperación con entidades públicas, privadas, organizaciones sociales y organismos de cooperación para obtener financiamiento de iniciativas y formular proyectos que permitan gestionar recursos para el fortalecimiento organizativo, territorial, productivo, ambiental y social de la asociación. </documentation>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Gestionar el Plan de Desarrollo Sostenible" id="id-9607b9c5e0704bfa9cfb0f97a0367217">
            <documentation>Proceso orientado a coordinar la formulación, actualización, seguimiento y articulación del Plan de Desarrollo Sostenible (PDS) como instrumento de planificación participativa de la Zona de Reserva Campesina, promoviendo la ejecución de sus líneas estratégicas y el cumplimiento de los objetivos definidos por las comunidades campesinas</documentation>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Gestionar la organización comunitaria" id="id-8aa199525c16477bafc94eccf374ef95">
            <documentation>Proceso encargado de fortalecer la estructura organizativa de la asociación mediante la coordinación de espacios de participación, la articulación entre las diferentes instancias organizativas y el acompañamiento a los procesos comunitarios desarrollados en el territorio.</documentation>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Atender solicitudes de subsanación" id="id-9db4043b71a24ae1a32edafae9a09877"/>
          <element xsi:type="archimate:BusinessProcess" name="Aprobar proyecto" id="id-62ff1d7baad24869b74eb62041305969"/>
          <element xsi:type="archimate:BusinessProcess" name="Desginar responsable" id="id-1ab999179c3f4efb842a3be222f83e23"/>
          <element xsi:type="archimate:BusinessProcess" name="Formular proyecto asociado" id="id-13d3da10307f4d84ad6dea97d12ee3b5"/>
          <element xsi:type="archimate:BusinessProcess" name="Generar formatos de registro a convocatoria" id="id-7c9fe10a46824ebe98b052c0614aceac"/>
          <element xsi:type="archimate:BusinessProcess" name="Recopilar documentos solicitados" id="id-faa74ecc71ba4e54911934234864eac3"/>
          <element xsi:type="archimate:BusinessProcess" name="Revisar requisitos de evaluación" id="id-e647c7ab532447b5b681013560e78e9d"/>
          <element xsi:type="archimate:BusinessProcess" name="Verificar criterios habilitantes" id="id-fa404f9d626444d3b96fedf24c2c59ea"/>
          <element xsi:type="archimate:BusinessProcess" name="Gestionar cooperación y financiación" id="id-d6dbb98c019e4e79b2217ddd9e2287bd">
            <documentation>Financia el equipo técnico ante la falta de presupuesto estatal</documentation>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Generar productos asociados a la ZRC" id="id-d280cfc3294f406e95adf7adfb74b05b"/>
          <element xsi:type="archimate:BusinessProcess" name="Emitir comunicado" id="id-7d01b7f2ef3c4eb483d773b0e2182a0f"/>
          <element xsi:type="archimate:BusinessProcess" name="Enviar interesados" id="id-9ac13dde7a484bd79503ec26e47d7e16"/>
          <element xsi:type="archimate:BusinessProcess" name="Enviar transporte a zonas" id="id-572caa5d684544c48aaa21fe3ee8bcb7"/>
          <element xsi:type="archimate:BusinessProcess" name="Gestionar logística" id="id-d57170d94428455ca3f67f99c965516b"/>
          <element xsi:type="archimate:BusinessProcess" name="Informar a entidad de convenio" id="id-dfb8e256186e427dbf7f4774bfa71bef"/>
        </folder>
        <folder name="Misionales" id="id-9d4333d0edaa46eeae11c3bfc9a205fd">
          <folder name="Gestion territorial" id="id-ad0716402ef34335a8ed75d0d605e3c8">
            <element xsi:type="archimate:BusinessProcess" name="Acompañar los procesos de regularización de tierras" id="id-7e4bf778244348bf9ab89c96000d4db0">
              <documentation>Proceso orientado a brindar acompañamiento a las comunidades en los procesos de formalización, adjudicación, restitución y demás mecanismos relacionados con la seguridad jurídica de la propiedad rural.</documentation>
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Articular los instrumentos de planificación territorial" id="id-2f0385247e7a403b96525c67ac1eaf91"/>
            <element xsi:type="archimate:BusinessProcess" name="Acompañar procesos jurídicos y de defensa territorial" id="id-bb0c1999a30f44b9b6e9dc5ad20b3998">
              <documentation>Proceso mediante el cual la ACIT acompaña la gestión de procedimientos jurídicos y administrativos relacionados con la defensa del territorio y la garantía de los derechos campesinos. Comprende el seguimiento a trámites ante entidades públicas, la preparación y radicación de solicitudes, recursos y acciones jurídicas cuando son necesarias, así como la articulación con organizaciones y profesionales que brindan apoyo técnico y jurídico para fortalecer los procesos colectivos.</documentation>
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Censar y caracterizar la tenencia de la tierra" id="id-2120f67da3ff486fbe1b9b329dda3ccc">
              <documentation>Proceso encargado de recopilar, organizar y analizar información sobre las condiciones de tenencia de los predios rurales, apoyando la toma de decisiones y los procesos de ordenamiento territorial.</documentation>
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Coordinar la gestión de la Zona de Reserva Campesina" id="id-485c27e4e2ca45d08f4622cbae5e06e4">
              <documentation>Proceso mediante el cual se desarrollan acciones orientadas a la consolidación, seguimiento y fortalecimiento de la Zona de Reserva Campesina como instrumento de ordenamiento territorial y permanencia campesina. </documentation>
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Mediar conflictos territoriales" id="id-577f022c5093477984c557ff38a27458">
              <documentation>Proceso mediante el cual se promueven espacios de diálogo, conciliación y concertación para la resolución pacífica de conflictos relacionados con la tenencia, uso y administración del territorio.</documentation>
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Analizar restricciones ambientales" id="id-66e552df970c40cda85826c7c68518d4">
              <documentation>(Ley Segunda de 1952): Verificar si el predio está protegido, lo cual legalmente impide que la ANT lo pueda adjudicar.</documentation>
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Clasificar jurídicamente predios" id="id-c486864733884e89ae3b4926432f0468">
              <documentation>Determinar qué tipo de tierra es y qué proceso requiere</documentation>
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Evaluar determinantes ambientales" id="id-bd44a761322a49679cdb86f94d65f867">
              <documentation>Revisar afectaciones ecológicas generales.</documentation>
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Realizar estudio agronómico" id="id-bcdb20302e3941d7b72aefa5956a5a56">
              <documentation>Evaluar el suelo y las condiciones del predio para certificar ante la ANT que la tierra es viable para ser trabajada.</documentation>
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Caracterizar la poblacional y su autoidentificación" id="id-933485b22e1949918dfda3f31f81e7ad">
              <documentation>Identificar si los habitantes se reconocen como indígenas, campesinos o ambos</documentation>
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Gestionar los entornos educativos" id="id-bc0e24d90b854561927aeaf81bb31333">
              <documentation>Intervenir en las tensiones de las escuelas veredales, donde existe un interés económico y político por imponer modelos de etnoeducación indígena.</documentation>
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Mediar en tensiones territoriales y culturales" id="id-80d9baea68814c58abf9ea5f9c9d4b2e">
              <documentation>Manejar situaciones de presión por la constitución de resguardos, la afiliación forzada a cabildos o la delimitación de tierras</documentation>
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Relacionar Predio-Tenencia" id="id-61e42711f6f744cd8dbb7fdf3341cbb7">
              <documentation>Cruzar la información geoespacial con la persona que ejerce la tenencia y su identidad cultural</documentation>
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Delegar encargados y profesionales" id="id-74f06854767c4e989d0d6a86dbba6bc6"/>
            <element xsi:type="archimate:BusinessProcess" name="Establecer zona" id="id-cc298eda9e3846b28dc0ecd0bdedcf27"/>
            <element xsi:type="archimate:BusinessProcess" name="Generar datos de censo y caracterización" id="id-e2129e57cf32422a958ec128e302a907"/>
            <element xsi:type="archimate:BusinessProcess" name="Gestionar la relación con la ANT" id="id-66527afef4bd4b53b7838c6a5b949101"/>
            <element xsi:type="archimate:BusinessProcess" name="Identificar finalidad del terreno" id="id-5435a264879840c0b4aa37ded3e4fcdf"/>
            <element xsi:type="archimate:BusinessProcess" name="Integrar la información territoriail para la toma de decisiones" id="id-7108bedb0a6240aba119be67bb99e263"/>
            <element xsi:type="archimate:BusinessProcess" name="Hacer seguimiento a los procedimientos" id="id-a19028d3eb814cf09d26fb5805d6903d"/>
            <element xsi:type="archimate:BusinessProcess" name="Identificar marco jurídico aplicable" id="id-99faa47426394f9881e35f0ae401aa91"/>
            <element xsi:type="archimate:BusinessProcess" name="Preparar documentación requerida" id="id-8199e0c082e04ad6aba4092002f498bf"/>
            <element xsi:type="archimate:BusinessProcess" name="Radicar solicitudes ante entidades competentes" id="id-dfae85bd9f80425798c2d3b743752f09"/>
            <element xsi:type="archimate:BusinessProcess" name="Usar recursos y acciones constitucionales" id="id-8f8e7476be654c2799b6589cd8f45277"/>
          </folder>
          <folder name="Educaciónm, cultura y bienestar" id="id-5250ba9905364feca3b669dbbb50e0dc">
            <element xsi:type="archimate:BusinessProcess" name="Desarrollar procesos de formación política y comunitaria" id="id-5ebfc03952604e7098af9f40291087bb">
              <documentation>Proceso orientado al fortalecimiento de las capacidades organizativas y de liderazgo del campesinado mediante espacios permanentes de formación.</documentation>
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Fomentar el bienestar e integración comunitaria" id="id-3147417ebc1145ed83a8d535f287b263">
              <documentation>Proceso mediante el cual se desarrollan actividades deportivas, recreativas y culturales que fortalecen la convivencia, la identidad campesina y el tejido social de las comunidades.</documentation>
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Gestionar procesos comunitarios para la conservación del territorio" id="id-b469c874a8c54ac1a3b5ea8bb2317db6">
              <documentation>Proceso mediante el cual la ACIT fortalece la relación entre el campesinado y el territorio mediante acciones de educación ambiental, conservación de los ecosistemas, restauración ecológica, monitoreo comunitario y promoción de prácticas agroecológicas que contribuyen al cuidado de la biodiversidad y al reconocimiento del campesinado como sujeto ambiental.</documentation>
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Gestionar el conocimiento y la comunicación comunitaria" id="id-62b4989a2d7d418e9a9dd0198efbbab8">
              <documentation>Proceso mediante el cual se genera, organiza, preserva y difunde el conocimiento construido por la organización y las comunidades, fortaleciendo la comunicación comunitaria y la memoria territorial.</documentation>
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Espacios de capacitación" id="id-11cf2f5b24e9426487c8b63af0367342"/>
            <element xsi:type="archimate:BusinessProcess" name="Formación política" id="id-b5254f41e8414e90a182b2edbcfc363e"/>
            <element xsi:type="archimate:BusinessProcess" name="Coordinar acciones comunitarias de conservación y restauración ecológica" id="id-dc3852de318d47198a5cdbf3f7976424">
              <documentation>Siembra de frailejones, árboles y recuperación de semillas nativas</documentation>
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Gestión de contenidos comunitarios" id="id-9227dff6844441de973c78169640b5be"/>
            <element xsi:type="archimate:BusinessProcess" name="Fortalecer la educación ambiental comunitaria" id="id-1e0a2121f5bf4b8184ad226fd29c020c">
              <documentation>Charlas, recorridos, muralismo, campañas de consciencia y cultura ambiental para la sensibilización y promoción de prácticas de conservación ambiental con niños, niñas, adolescentes, jóvenes, líderes, lideresas y la conversa con los abuelos.</documentation>
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Formación comunitaria" id="id-2a086df617ac45ada296cd82ec7169a2"/>
            <element xsi:type="archimate:BusinessProcess" name="Gestión del conocimiento" id="id-030509e2896446688b7ccae6f8325859"/>
            <element xsi:type="archimate:BusinessProcess" name="Investigación comunitaria" id="id-4e6d2813972047968a692e3da224ff2b"/>
            <element xsi:type="archimate:BusinessProcess" name="Realizar monitoreo comunitario de la biodiversidad" id="id-02fca3cd5fa64287b074ea7783fa9c0d">
              <documentation>Identificación y avistamiento de especies.</documentation>
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Abrir espacios de opinión" id="id-cf76d4fffa374b319c2159a8025da22e"/>
            <element xsi:type="archimate:BusinessProcess" name="Comunicar temas de educación campesina" id="id-d12ee7551dab4fe58b26ebe28f687a86"/>
            <element xsi:type="archimate:BusinessProcess" name="Difundir información organizativa" id="id-7beeb052350846d4a00a2789fe6c840a"/>
            <element xsi:type="archimate:BusinessProcess" name="Documentar experiencias" id="id-c989254b3edc41448ad7a1bc38664d76"/>
            <element xsi:type="archimate:BusinessProcess" name="Transmitir la identidad campesina" id="id-9796380274f247ffac223bb059dbd054"/>
            <element xsi:type="archimate:BusinessProcess" name="Desarrollar recorridos pedagógicos" id="id-de3d216b19484b3b952325b846be234b"/>
            <element xsi:type="archimate:BusinessProcess" name="Organizar jornadas ambientales" id="id-3dfaa13fc070498da93fda06c3968e86"/>
            <element xsi:type="archimate:BusinessProcess" name="Recuperación de semillas nativas" id="id-ae349100533648bfb6bef69924795cb3"/>
            <element xsi:type="archimate:BusinessProcess" name="Restauración de nacimientos de agua" id="id-ed544c6d60424619ac2d5cc4ba79c55a"/>
          </folder>
          <folder name="Desarrollo productivo" id="id-7cf0760760cd47448dda393fd167dadd">
            <element xsi:type="archimate:BusinessProcess" name="Fortalecer las iniciativas productivas campesinas" id="id-37a3993605624a128fd2a5c609abe717">
              <documentation>Agrupa las acciones de acompañamiento a iniciativas productivas familiares, comunitarias y asociativas relacionadas con la producción agroecológica, la transformación de alimentos y la prestación de servicios vinculados al territorio. Busca mejorar las capacidades organizativas, técnicas y económicas de las familias campesinas, promover condiciones dignas de trabajo e ingreso y fortalecer alternativas económicas compatibles con la permanencia en el territorio.</documentation>
            </element>
            <element xsi:type="archimate:BusinessProcess" name="Transformación y comercialización de productos campesinos." id="id-0202642e585f49d79c82681419512423">
              <documentation>Proceso orientado a fortalecer los canales de comercialización y distribución de productos campesinos, promoviendo mercados solidarios y mecanismos de venta directa.</documentation>
            </element>
          </folder>
        </folder>
      </folder>
      <folder name="Otros" id="id-9e89b4597e0a4aa59098bdb154386539">
        <element xsi:type="archimate:BusinessProcess" name="Administrar cuentas y permisos" id="id-1dfc17848e614746a94da81ba7e383d1"/>
        <element xsi:type="archimate:BusinessProcess" name="Administrar la nube ACIT" id="id-92a49ae93a9f49f6b2b924efff579c20"/>
        <element xsi:type="archimate:BusinessProcess" name="Implementar gestion de la nube" id="id-be2485b6831d4d8abf859d35cbe495fd"/>
        <element xsi:type="archimate:BusinessProcess" name="Planeación de proyectos y talleres" id="id-771f811017b94f5cbbadd9aa20bbd59b"/>
        <element xsi:type="archimate:BusinessProcess" name="Tramitar documentos legales territoriales" id="id-2cc1e63ad51b4de8b38e212ddd24bca4"/>
      </folder>
    </folder>
    <folder name="Servicios" id="id-a4cfc4a620c64a17b90dad19a877dc85">
      <element xsi:type="archimate:BusinessService" name="Acompañamiento jurídico territorial" id="id-bf9c85bc0267407384df4617ade34f9e">
        <documentation>Acompañamiento a comunidades y procesos organizativos en la gestión de actuaciones jurídicas relacionadas con la defensa del territorio, la garantía de derechos campesinos y el seguimiento a procedimientos administrativos ante entidades del Estado.</documentation>
      </element>
      <element xsi:type="archimate:BusinessService" name="Almacenamiento de datos" id="id-7962ab4413d3404c9cd6bd622be44f4c"/>
      <element xsi:type="archimate:BusinessService" name="Apoyo a procesos de economía social y solidaria" id="id-ec1547bc4b4a45fe8166128c2683e71a">
        <documentation>Asesoría para fortalecer iniciativas productivas campesinas, promover la transformación y el valor agregado de los productos locales, surge como forma de organizar la economía mediante la gestión colectiva de los recursos, orientada a sostener y dignificar la vida de las personas, las comunidades y la naturaleza </documentation>
      </element>
      <element xsi:type="archimate:BusinessService" name="Comunicación comunitaria" id="id-eaf590a3148b49af9cc681c70a9d5f4a">
        <documentation>Prestación de acompañamiento, información oportuna y espacios de comunicación comunitaria que fortalecen la participación y el acceso a la información de las comunidades rurales.</documentation>
      </element>
      <element xsi:type="archimate:BusinessService" name="Apoyo a la comercialización campesina" id="id-3873bf2bfc8c4de2bc511ef8817afb99">
        <documentation>Articulación de canales de comercialización mediante iniciativas como MercACIT y el centro de acopio.</documentation>
      </element>
      <element xsi:type="archimate:BusinessService" name="Derechos, género y representación" id="id-975384b6ee404604be2d8feafe5ccde2"/>
      <element xsi:type="archimate:BusinessService" name="Desarrollo productivo y economía campesina" id="id-b00d1677a4544ee1ac26106fd34ef28b"/>
      <element xsi:type="archimate:BusinessService" name="Diagnóstico de tenencia" id="id-7bddd822d79f4fea99b67edaead02e8b">
        <documentation>Caracterización y recopilación de información sobre la situación de tenencia de los predios para apoyar procesos de formalización y planificación territorial. </documentation>
      </element>
      <element xsi:type="archimate:BusinessService" name="Organización y participación comunitaria" id="id-6e1f919f93354d6d99009c58d9008706">
        <documentation>Coordinación de espacios de participación, deliberación y toma de decisiones colectivas mediante asambleas, reuniones y procesos organizativos que fortalecen la gobernanza de la asociación. </documentation>
      </element>
      <element xsi:type="archimate:BusinessService" name="Educación, cultura y bienestar comunitario" id="id-41f3473c0e29446c9fbbc2d63d6bdad6"/>
      <element xsi:type="archimate:BusinessService" name="Formación deportiva comunitaria" id="id-8e2eefe45b144166919967d0a1818c90">
        <documentation>Espacios de recreación y formación física para la juventud rural.</documentation>
      </element>
      <element xsi:type="archimate:BusinessService" name="Educación Ambiental y Conservación del Territorio" id="id-ce213b41f2aa49aa9cb0b857c7ed809d">
        <documentation>Promoción de procesos de formación y fortalecimiento de capacidades para la conservación y restauración de los ecosistemas.</documentation>
      </element>
      <element xsi:type="archimate:BusinessService" name="Fortalecimiento de los derechos de las mujeres rurales" id="id-16242398f8914b0aa528cdb88581d9df">
        <documentation>Escuelas de empoderamiento enfocadas en la autonomía económica, el derecho a la propiedad de la tierra y la participación en la toma de decisiones.</documentation>
      </element>
      <element xsi:type="archimate:BusinessService" name="Formación política campesina" id="id-3cff2bd6c2eb4bbca5d1d59e96ab053a">
        <documentation>Programas de capacitación orientados a fortalecer el liderazgo, el conocimiento de derechos territoriales y la participación ciudadana activa en la asociación. </documentation>
      </element>
      <element xsi:type="archimate:BusinessService" name="Gestión y asesoría para la formalización y adjudicación de tierras" id="id-d390760d947f47e585e31b894c9959ce">
        <documentation>Acompañamiento en la gestión ante la Agencia Nacional de Tierras para que las familias campesinas obtengan títulos de propiedad legítimos.</documentation>
      </element>
      <element xsi:type="archimate:BusinessService" name="Gestión administrativa, financiera y legal" id="id-794d007a77734ca3ae463b9791956212"/>
      <element xsi:type="archimate:BusinessService" name="Formulación y gestión de proyectos y financiamiento" id="id-2dd6d8b36d834784b17205a631348ff8">
        <documentation>mediante el cual la asociación accede a recursos de cooperación y financiamiento para el desarrollo de iniciativas comunitarias.</documentation>
      </element>
      <element xsi:type="archimate:BusinessService" name="Gestión de la Información" id="id-68b83ac3de1c40c1a40454ce76d44dd2">
        <documentation>Administración de la información institucional mediante procesos de recopilación, almacenamiento, actualización y disponibilidad de datos estratégicos para apoyar la toma de decisiones y la gestión organizacional.</documentation>
      </element>
      <element xsi:type="archimate:BusinessService" name="Gestión Jurídica Institucional" id="id-6f34860d44bc46bc8c98d07569ac8bd0">
        <documentation>Gestión de los trámites ante Cámara de Comercio u organismos competentes para mantener vigente la personería jurídica. Incluye la organización de asambleas generales, actualización de estatutos, registro de actas y cumplimiento de informes ante entes de control. </documentation>
      </element>
      <element xsi:type="archimate:BusinessService" name="Investigación y conocimiento territorial" id="id-f192ae86f667463ca29dd2a22a2bb338">
        <documentation>Generación, sistematización y difusión de información sobre la realidad territorial para apoyar la toma de decisiones comunitarias y la formulación de iniciativas de desarrollo rural. </documentation>
      </element>
      <element xsi:type="archimate:BusinessService" name="Mediación de conflictos territoriales" id="id-2146dc9498914c219106b513f76f128a">
        <documentation>Facilitación de espacios de diálogo y conciliación comunitaria para la resolución de conflictos relacionados con el uso y la tenencia del territorio. </documentation>
      </element>
      <element xsi:type="archimate:BusinessService" name="Representación política y vocería" id="id-bb4f7ca9383c42b6a9d04882c4def89d">
        <documentation>Representación e incidencia ante espacios de diálogo locales, nacionales e internacionales para la defensa de los derechos del campesinado y la Zona de Reserva Campesina.</documentation>
      </element>
      <element xsi:type="archimate:BusinessService" name="Gestión Financiera" id="id-f320e3a8a4b24ad0a9a5b5e4de44c363">
        <documentation>Administración y control de los recursos financieros de la asociación, garantizando la adecuada ejecución presupuestal, la transparencia y la rendición de cuentas.</documentation>
      </element>
      <element xsi:type="archimate:BusinessService" name="Tierras y ordenamiento social de la propiedad" id="id-059a46b21a464e23919604c786ec6a0e"/>
      <element xsi:type="archimate:BusinessService" name="Gestión de herramientas de autonomía territorial (ZRC)" id="id-9bfc73ffee8f40e4a160e8cc52e0ca83">
        <documentation>Coordinación y seguimiento de las acciones relacionadas con la administración, planificación y fortalecimiento de la Zona de Reserva Campesina, promoviendo la participación comunitaria y el cumplimiento de los instrumentos de ordenamiento territorial.</documentation>
      </element>
      <element xsi:type="archimate:BusinessService" name="Gestion documental" id="id-be325387c0654557b95cacf91468d10b">
        <documentation>Organización, conservación y consulta de la documentación institucional, garantizando la disponibilidad, trazabilidad y preservación de la memoria organizacional.</documentation>
      </element>
    </folder>
    <folder name="Roles" id="id-008ee4284903414a898a07e848571c93">
      <element xsi:type="archimate:BusinessRole" name="Profesional Solidario" id="id-91f7dc508e9043b8aa2edff92ff203df"/>
      <element xsi:type="archimate:BusinessRole" name="Líder de proyecto" id="id-76155d3a8857464a8048010a85096b73"/>
      <element xsi:type="archimate:BusinessRole" name="Representante Zonal" id="id-1d97c10d7f6b43269a80ad013d260124"/>
    </folder>
    <folder name="Colaboraciones" id="id-88f8d92c906543709f3a4fe5f6919959">
      <element xsi:type="archimate:BusinessCollaboration" name="Asamblea General Campesina" id="id-3e953b5d54f24a108e55f20b8dcd8fff"/>
      <element xsi:type="archimate:BusinessCollaboration" name="Familias campesinas" id="id-939b812e406849438ad664a0c14c5238"/>
      <element xsi:type="archimate:BusinessCollaboration" name="Directiva Central" id="id-daea73f15657485ea1a635da552a0abc"/>
    </folder>
    <folder name="Eventos" id="id-aa167b0f13f7461594c4370006b8d383">
      <element xsi:type="archimate:BusinessEvent" name="Acuerdo comunitario" id="id-b42ff7c313ef4303a377cedad3f55071"/>
      <element xsi:type="archimate:BusinessEvent" name="Restricción ambiental" id="id-4811081312ec46299f91283157ca77af"/>
      <element xsi:type="archimate:BusinessEvent" name="Viabilidad de tenencia" id="id-94a7afd51cff4452938daec6487ae15b"/>
      <element xsi:type="archimate:BusinessEvent" name="Convocatoria" id="id-6a325969eb3a4de38521081a732c9bd1"/>
      <element xsi:type="archimate:BusinessEvent" name="Comunicado oficial" id="id-9c87e5bd391341e8ba96e57d7a1f5c3e"/>
      <element xsi:type="archimate:BusinessEvent" name="Evento comunitario" id="id-8b864a1ce42a4930aa6444dffd4ac491">
        <documentation>Reunión, taller, asamblea</documentation>
      </element>
      <element xsi:type="archimate:BusinessEvent" name="Solicitud de actuación jurídica territorial" id="id-eadce91e1bf8452dacdf04f8008e2466"/>
      <element xsi:type="archimate:BusinessEvent" name="Asamblea" id="id-375749c4d0a34e22be858163a4a40aa6"/>
      <element xsi:type="archimate:BusinessEvent" name="Campaña ambiental" id="id-f3877e7cb69e4242b44f66ed136aee92"/>
      <element xsi:type="archimate:BusinessEvent" name="Censo" id="id-5716938b5ace4303bb2686234153b2fa"/>
      <element xsi:type="archimate:BusinessEvent" name="Jornada de trabajo" id="id-7de2729d021e4ae5bd6be4fd9b7ce836"/>
      <element xsi:type="archimate:BusinessEvent" name="Movilización" id="id-b7ac06499b7544afab92bd46b74e3ad0"/>
      <element xsi:type="archimate:BusinessEvent" name="Proyecto" id="id-2a1e394173be4eec9ddf9207615768f3"/>
      <element xsi:type="archimate:BusinessEvent" name="Reunión" id="id-d1b9167ab6474470ba5ab928d2afe212"/>
    </folder>
    <folder name="Productos" id="id-2c76ae8855b34d9c8e866048caf950ce">
      <element xsi:type="archimate:Product" name="Informes multidimensionales por componentes" id="id-fe8fcc61ecd542d19730c60fa81aa956"/>
    </folder>
    <folder name="Objetos" id="id-9c014464883349188283d0cdacd002ad">
      <element xsi:type="archimate:BusinessObject" name="Plan de desarrollo sostenible" id="id-5ea9f63020b94fb292e9a9acfd624492"/>
    </folder>
    <folder name="Contratos" id="id-1092785ee9434f5eada650472909399c">
      <element xsi:type="archimate:Contract" name="Convenio" id="id-b3692b6433ff4f73a4184427f6a011e5"/>
    </folder>
    <element xsi:type="archimate:BusinessEvent" name="Siembra de frailejones" id="id-e3efb279c87244d284d3e24226cbca5c"/>
    <element xsi:type="archimate:BusinessEvent" name="Siembra de árboles" id="id-86ae1e2685054b72b8559d4d11649357"/>
    <element xsi:type="archimate:BusinessProcess" name="Articular procesos con escuelas territoriales" id="id-5e8ab24b58bf40719a80aafb6d71fe50"/>
    <element xsi:type="archimate:BusinessProcess" name="Fortalecimiento de sistemas agroecológicos campesinos" id="id-90891222e02d40eb878ae6bbb9fe32f6">
      <documentation>Comprende la implementación, acompañamiento y consolidación de sistemas de producción campesina basados en la agroecología, la agricultura orgánica, la diversificación de cultivos y el manejo sostenible del suelo, el agua y la biodiversidad. Incluye la transición hacia prácticas agroecológicas, la producción de alimentos de pancoger, la elaboración de abonos orgánicos y el uso de microorganismos de montaña, entre otras prácticas que disminuyan la dependencia de insumos externos.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Conservación e intercambio comunitario de semillas y saberes campesinos" id="id-11cd1ed2c216447ca1795d95fc1133b1">
      <documentation>Incluye la identificación, recuperación, selección, reproducción, conservación y propagación de semillas nativas, criollas y tradicionales, así como la creación y fortalecimiento de casas comunitarias de semillas. También comprende los encuentros e intercambios mediante los cuales las familias, personas mayores, docentes, mujeres, jóvenes y productores transmiten los conocimientos relacionados con la siembra, el cuidado, el uso y la adaptación de las semillas al territorio.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Promoción de la soberanía alimentaria" id="id-30a8adc1fc5c43e7adc317ec0a211502">
      <documentation>Comprende las acciones destinadas a fortalecer la capacidad de las comunidades para decidir qué alimentos producir, cómo producirlos, cómo distribuirlos y cómo consumirlos, de acuerdo con sus necesidades, conocimientos y condiciones territoriales. Incluye la producción diversificada de alimentos, el autoconsumo familiar y comunitario, la protección de las semillas, la alimentación saludable y la visibilización del campesinado como actor fundamental para garantizar la alimentación de la sociedad.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Restauración ecológica" id="id-1df4e1b4f9364c0d947ed94a22cc9af7">
      <documentation>Comprende las acciones comunitarias dirigidas a recuperar ecosistemas, suelos, bosques, nacimientos de agua y áreas afectadas por procesos de degradación. Incluye la siembra de árboles y especies nativas, la propagación de frailejones, la restauración de suelos, la recuperación de coberturas vegetales y el establecimiento de acciones de seguimiento para favorecer la recuperación de las funciones ecológicas del territorio.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Gestión comunitaria del agua" id="id-45b209758a854bf3a4a497f3629b3574">
      <documentation>Incluye la identificación, protección, recuperación y seguimiento de nacimientos, quebradas, ríos, lagunas, páramos y demás fuentes hídricas del territorio. Comprende recorridos comunitarios, jornadas de restauración, procesos de sensibilización y acuerdos colectivos para el cuidado del agua, reconociéndola como un bien común indispensable para la vida, la producción campesina y la permanencia de las comunidades.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Educación ambiental comunitaria" id="id-ac1e3fc9c902448aaf16d423e3b34520">
      <documentation>Agrupa los procesos de formación, sensibilización y construcción colectiva de conocimientos relacionados con el cuidado de la naturaleza y el territorio. Incluye charlas, campañas, muralismo, recorridos ambientales, encuentros comunitarios, actividades escolares y diálogos intergeneracionales dirigidos a niños, niñas, jóvenes, familias, líderes y lideresas campesinas.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Transformación y comercialización de productos campesinos" id="id-6c1f47d064374782a44dfc6e91dfd349">
      <documentation>Incluye los procesos mediante los cuales los productos agrícolas y agroecológicos son acondicionados, transformados, almacenados, intercambiados y comercializados, procurando conservar su valor cultural, ambiental y alimentario. Comprende mercados campesinos, ferias, intercambios solidarios, circuitos cortos de comercialización y escenarios de articulación entre el campo y la ciudad que permitan reducir intermediarios y visibilizar el aporte de la producción campesina.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Protección de la biodiversidad" id="id-009005514ac3420192b235e2bf63e3bf">
      <documentation>Comprende las acciones destinadas a reconocer, conservar y recuperar las especies de flora y fauna, sus hábitats y los corredores ecológicos que conectan los diferentes ecosistemas del territorio. Incluye la protección de aves, abejas nativas, polinizadores, orquídeas, árboles nativos y otras especies, así como la documentación de conocimientos comunitarios y el desarrollo de prácticas productivas que favorezcan la diversidad biológica.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Reconocimiento y apropiación comunitaria del territorio" id="id-d73b27b58643496ea3c739f8da54cc34">
      <documentation>Comprende recorridos, ejercicios de observación, cartografía comunitaria y espacios de diálogo mediante los cuales las comunidades identifican las características, potencialidades, problemáticas y lugares de importancia ambiental del territorio. Busca fortalecer el sentido de pertenencia, la memoria territorial y la participación de las comunidades en las decisiones relacionadas con el uso, la protección y la defensa de los ecosistemas.</documentation>
    </element>
    <element xsi:type="archimate:BusinessProcess" name="Formación de cuidadores y cuidadoras del territorio" id="id-109ca99695304a119e289ade7198c6ba">
      <documentation>Incluye los procesos organizativos y educativos dirigidos a vincular a niños, niñas, jóvenes y demás integrantes de la comunidad con el cuidado de montañas, páramos, fuentes hídricas, bosques y especies. Comprende iniciativas como cuidadores de la montaña, guardianes de aves y juntanzas por el agua, promoviendo responsabilidades comunitarias y la transmisión generacional de saberes ambientales.</documentation>
    </element>
  </folder>
