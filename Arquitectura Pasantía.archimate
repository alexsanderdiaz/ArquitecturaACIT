    <folder name="Procesos" id="id-15285153ecdc405888d07584f51478e9">
      <folder name="Macroprocesos" id="id-a6c84baed77f482c8275940e24fb2b36">
        <folder name="Procesos misionales" id="id-c5d09cc1c6c14a4497ccf345dc21a4cd"/>
        <folder name="Procesos transversales" id="id-62da4c507f0443359ea015a819b7bdc7">
          <element xsi:type="archimate:BusinessProcess" name="Direccionamiento y gestión estratégica" id="id-cfc1f7a0322f4b259b2e2380a0b92608">
            <documentation>Orienta política y estratégicamente a la ACIT, articulando sus instancias de gobierno, prioridades organizativas, reivindicaciones, decisiones, alianzas y mecanismos de incidencia. Comprende la definición de agendas y orientaciones colectivas, la gestión de acuerdos y compromisos, la representación campesina, la interlocución con actores institucionales y sociales y el seguimiento de las prioridades estratégicas de la organización.</documentation>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Gestión administrativa, financiera y contractual" id="id-03a3ef2491da4a3ab2ac44fb2a44a35f">
            <documentation>Administra los recursos, obligaciones y operaciones necesarias para el funcionamiento institucional y la ejecución de iniciativas de la ACIT. Comprende la gestión contable y financiera, tesorería, presupuestos, centros de costo, compras, contratación, convenios, obligaciones tributarias, activos, soportes administrativos y preparación de información para seguimiento y rendición de cuentas.</documentation>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Gestión de información territorial y datos" id="id-72cd7d60af2142f7926eae180c9c1ee2">
            <documentation>Gobierna la producción, organización, integración, calidad, análisis y uso de los datos asociados al territorio y a los procesos de la organización. Comprende caracterizaciones, información poblacional, predial, jurídica, productiva, ambiental y geográfica, así como metadatos, procedencia, temporalidad, indicadores, estadísticas y contraste entre información comunitaria y fuentes oficiales.</documentation>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Gestión de personas, asociados y capacidades organizacionales" id="id-1fc4f00bd0ec41b4a0e59fde9a35b6db">
            <documentation>Gestiona la vinculación, participación, responsabilidades y fortalecimiento de las personas que sostienen los procesos de la organización. Comprende asociados, liderazgos, responsables, comités, equipos de proyecto, participantes y beneficiarios, así como formación, desarrollo de capacidades, asignación de roles, relevo, empalmes y continuidad de responsabilidades.</documentation>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Gestión de proyectos y cooperación" id="id-4352073353f0464c8c40f822efddf8a8">
            <documentation>Gestiona el ciclo de vida de proyectos, convenios e iniciativas y las relaciones de cooperación asociadas a ellos. Comprende la identificación de oportunidades, formulación, gestión de financiación, formalización, ejecución, seguimiento, entrega de productos, cierre, transferencia de resultados y preservación de la experiencia institucional generada.</documentation>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Gestión documental, memoria y conocimiento" id="id-12a914dbbcd44385ba6c46ff28a3f49b">
            <documentation>Organiza, preserva, contextualiza y facilita la recuperación y reutilización de la información y el conocimiento producido por la ACIT a lo largo de sus procesos, proyectos y trayectoria histórica. Comprende la gestión documental, archivo, investigaciones, tesis, cartografía, memoria audiovisual, productos de proyectos, metodologías, versiones, metadatos, transferencia entre responsables y preservación de la memoria institucional.</documentation>
          </element>
          <element xsi:type="archimate:BusinessProcess" name="Gestión jurídica y normativa" id="id-64d1fed86574459b9457292155d3800b">
            <documentation>Brinda soporte jurídico y normativo a los procesos organizativos, territoriales, administrativos y de defensa de derechos de la ACIT. Comprende el análisis de situaciones con implicaciones jurídicas, la definición y acompañamiento de estrategias administrativas y judiciales, la gestión de expedientes y términos, el manejo de soportes probatorios, el seguimiento de actuaciones y decisiones, y la articulación con aliados jurídicos externos.</documentation>
          </element>
        </folder>
      </folder>
      <folder name="Procesos transversales" id="id-9e89b4597e0a4aa59098bdb154386539">
        <folder name="Gestión jurídica y normativa" id="id-cee3a75914db43bcab02e2456d2ea8d8">
          <element xsi:type="archimate:BusinessProcess" name="Analizar situaciones con implicaciones jurídicas" id="id-4f8a71f4b16b4bdbbe6eec1052f65233"/>
          <element xsi:type="archimate:BusinessProcess" name="Definir estrategias jurídicas y administrativas" id="id-dfdecffd98b341368c248003d403a014"/>
          <element xsi:type="archimate:BusinessProcess" name="Articular apoyo jurídico externo" id="id-665b081b31074f338783b58f6e0a4c4e"/>
          <element xsi:type="archimate:BusinessProcess" name="Gestionar pruebas y soportes jurídicos" id="id-e960dd9734a1420fa7970bf3c3f778d6"/>
          <element xsi:type="archimate:BusinessProcess" name="Gestionar cumplimiento jurídico institucional" id="id-20d3f5b531d341b1a5e1d557f6a09579"/>
          <element xsi:type="archimate:BusinessProcess" name="Gestionar acciones judiciales y litigios" id="id-c344822cc01f4f8b8cbfaa116ab12297"/>
          <element xsi:type="archimate:BusinessProcess" name="Gestionar expedientes jurídicos" id="id-beb6d0259c984171891c0f9779cbc12b"/>
        </folder>
        <folder name="Gestión documental, memoria y conocimiento" id="id-6cd93789ca884bc692f0acbdd8bb8cc2">
          <element xsi:type="archimate:BusinessProcess" name="Recibir y registrar información organizacional" id="id-8c85178113374af3a2faf5c048c497c1"/>
          <element xsi:type="archimate:BusinessProcess" name="Recuperar y consultar conocimiento organizacional" id="id-6de9294313ff4a65b1c817a00f6dc4be"/>
