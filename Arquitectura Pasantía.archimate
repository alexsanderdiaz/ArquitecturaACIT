      <element xsi:type="archimate:CourseOfAction" name="Talleres y proyectos para fortalecer la identidad y conocimiento campesino" id="id-9815def4fd8d45d7b51e4ea434e6cecb"/>
      <element xsi:type="archimate:CourseOfAction" name="Participación y formación política" id="id-7976f623578f4b23a4c061171901aaa5"/>
